// Phase 1 + Phase 2 + Phase 3 + Phase 4 + Phase 5 + Phase 6 + Phase 7 + Phase 8 rules; review with docs/database/phase1-schema.md and docs/database/phase2-schema.md before rollout.
// Phase 2 people/asset/inventory validators are generated from packages/shared (see rules-generator.ts).
// Tenant root: companies/{companyId}. Only canonical active owner/admin membership grants access.
// Operational documents: companyId, schemaVersion=1, code, name, notes, status,
// createdAt/updatedAt timestamps, createdBy/updatedBy UIDs, revision/refCount integers,
// witnessKind/witnessId strings. Code, company, creation metadata and site identity are immutable.
// clients: clientType, contactPerson, phone, email, address, country, vatNumber.
// contracts: clientId, startDate/endDate calendar strings, serviceDescription.
// sites: clientId, optional contractId, propertyType, address/country/city, timeZone,
// workingDays, opensAt/closesAt, contactPerson, phone, description.
// locations: siteId, optional parentId, locationType, floorNumber, description.
// facilityTypes: description. facilities: siteId, locationId, typeId, condition, description.
// Optional domain strings are present as ''. Validators below enforce all types/limits/enums.
// codeClaims: immutable companyId/kind/recordId/code, created atomically with a new record.
// facility history: companyId/revision/condition/status/actorUid/occurredAt, append-only,
// bound to a new business revision. Client-attributed history is not a trusted audit trail.
// Counters count active DIRECT ownership references; ancestors are protected transitively.
// Bounded parent traversal and one-reference reassignment keep transactions within rule budgets.
// Phase 0 users, memberships, discovery hints and trusted audit records retain protected ownership.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function member(companyId){return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data;}
  // Rules 'let' bindings are re-evaluated on every use, so document data is passed as an argument (evaluated once).
  function admin(companyId){return signedIn() && adminDoc(member(companyId),companyId);}
  function adminDoc(m,companyId){return m.uid==request.auth.uid && m.companyId==companyId && m.status=='active' && m.role in ['owner','admin'];}
  function activeCompany(companyId){return get(/databases/$(database)/documents/companies/$(companyId)).data.status=='active' || co(companyId).status=='read_only' && request.method in ['get','list'];}
  // Phase 8: a suspended subscription sets status 'read_only' — the company stays readable (and exportable) but nothing can be written.
  function stamped(d){return d.updatedAt==request.time && d.updatedBy==request.auth.uid;}
  function born(d){return d.createdAt==request.time && d.createdBy==request.auth.uid;}
  function aa(c){return admin(c) && activeCompany(c);}
  function co(c){return get(/databases/$(database)/documents/companies/$(c)).data;}

  // IANA zone shape by region; the exact zone list is validated by the client schema (time-zones.json).
  function validZone(zone) {return zone is string && zone.matches('^(UTC|(Africa|America|Antarctica|Arctic|Asia|Atlantic|Australia|Europe|Indian|Pacific|Etc)/[A-Za-z0-9_+-]{1,40}(/[A-Za-z0-9_+-]{1,40})?)$');}
  function calendar(value) {
   let parts=value.split('-');
   let year=int(parts[0]); let month=int(parts[1]); let day=int(parts[2]);
   let lastDay=month==2 ? ((year%400==0 || (year%4==0 && year%100!=0))?29:28) : (month in [4,6,9,11]?30:31);
   return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && year>0 && month>=1 && month<=12 && day>=1 && day<=lastDay;
  }
  function optionalContact(d) {return d.get('contactEmail','') is string && d.get('contactEmail','').size()<=200 && d.get('contactPhone','') is string && d.get('contactPhone','').size()<=200 && d.get('address','') is string && d.get('address','').size()<=2000 && d.get('country','') is string && d.get('country','').size()<=200;}
  function known(k) {return k in ['clients','contracts','sites','locations','facilityTypes','facilities'];}
  function active(d) {return d.get('status','archived') != 'archived';}
  function witnessBefore(c,w,wid){return exists(/databases/$(database)/documents/companies/$(c)/$(w)/$(wid)) ? get(/databases/$(database)/documents/companies/$(c)/$(w)/$(wid)).data : {};}
  function witnessAfter(c,w,wid){return getAfter(/databases/$(database)/documents/companies/$(c)/$(w)/$(wid)).data;}
  function counter(c,k,id) {
   let w=request.resource.data.witnessKind;
   return w in {'clients':['contracts','sites'],'contracts':['sites'],'sites':['locations'],'locations':['locations','facilities'],'facilityTypes':['facilities'],'facilities':[]}[k]
    && counterMove(k,id,k=='clients'?'clientId':k=='contracts'?'contractId':k=='sites'?'siteId':k=='facilityTypes'?'typeId':w=='locations'?'parentId':'locationId',
       witnessBefore(c,w,request.resource.data.witnessId),witnessAfter(c,w,request.resource.data.witnessId));
  }
  function counterMove(k,id,field,before,after){
   return counterDelta(before.get('status','archived')!='archived' && before.get(field,'')==id && (k!='sites' || before.get('parentId','')==''),
     after.status!='archived' && after.get(field,'')==id && (k!='sites' || after.get('parentId','')==''));
  }
  function counterDelta(was,now){
   let d=request.resource.data;
   return was!=now
    && d.diff(resource.data).affectedKeys().hasOnly(['refCount','witnessKind','witnessId','updatedAt','updatedBy'])
    && d.refCount is int && d.refCount==resource.data.refCount+(now?1:-1) && d.refCount>=0
    && d.updatedAt==request.time && d.updatedBy==request.auth.uid;
  }
  function increment(c,k,id,tk,tid,n) {
   return incremented(get(/databases/$(database)/documents/companies/$(c)/$(tk)/$(tid)).data,getAfter(/databases/$(database)/documents/companies/$(c)/$(tk)/$(tid)).data,k,id,n);
  }
  function incremented(b,a,k,id,n){return a.refCount==b.refCount+n && a.witnessId==id && a.witnessKind==k;}
  function ref(c,k,id,field,targetKind) {
   let before=exists(/databases/$(database)/documents/companies/$(c)/$(k)/$(id)) ? get(/databases/$(database)/documents/companies/$(c)/$(k)/$(id)).data : {};
   let after=request.resource.data;
   let oldId=active(before) && !(k=='locations' && field=='siteId' && before.get('parentId','')!='') ? before.get(field,'') : '';
   let newId=active(after) && !(k=='locations' && field=='siteId' && after.get('parentId','')!='') ? after.get(field,'') : '';
   return (after.status!='archived' || after.get(field,'')==before.get(field,'')) && (newId=='' || active(getAfter(/databases/$(database)/documents/companies/$(c)/$(targetKind)/$(newId)).data))
    && (newId==oldId || ((oldId=='' || increment(c,k,id,targetKind,oldId,-1)) && (newId=='' || increment(c,k,id,targetKind,newId,1))));
  }
  function chain0(parent) {return parent=='';}
  function chain1(c,id,site,parent) {let d=parent=='' ? {} : getAfter(/databases/$(database)/documents/companies/$(c)/locations/$(parent)).data; return parent=='' || (parent!=id && d.siteId==site && d.status!='archived' && chain0(d.parentId));}
  function chain2(c,id,site,parent) {let d=parent=='' ? {} : getAfter(/databases/$(database)/documents/companies/$(c)/locations/$(parent)).data; return parent=='' || (parent!=id && d.siteId==site && d.status!='archived' && chain1(c,id,site,d.parentId));}
  function chain3(c,id,site,parent) {let d=parent=='' ? {} : getAfter(/databases/$(database)/documents/companies/$(c)/locations/$(parent)).data; return parent=='' || (parent!=id && d.siteId==site && d.status!='archived' && chain2(c,id,site,d.parentId));}
  function chain4(c,id,site,parent) {let d=parent=='' ? {} : getAfter(/databases/$(database)/documents/companies/$(c)/locations/$(parent)).data; return parent=='' || (parent!=id && d.siteId==site && d.status!='archived' && chain3(c,id,site,d.parentId));}

  function relations(c,k,id) {
   let d=request.resource.data;
   return (k=='clients' || k=='facilityTypes')
    || (k=='contracts' && ref(c,k,id,'clientId','clients'))
    || (k=='sites' && (d.schemaVersion==2 || (ref(c,k,id,'clientId','clients') && ref(c,k,id,'contractId','contracts'))))
    || (k=='contractAllocations' && allocationRelations(c,id))
    || (k=='locations' && ref(c,k,id,'siteId','sites') && ref(c,k,id,'parentId','locations') && (!active(d) || chain4(c,id,d.siteId,d.parentId)))
    || (k=='facilities' && ref(c,k,id,'locationId','locations') && ref(c,k,id,'typeId','facilityTypes') && (!active(d) || getAfter(/databases/$(database)/documents/companies/$(c)/$('locations')/$(d.locationId)).data.siteId==d.siteId));
  }
  function business(c,k,id) {
   let d=request.resource.data;
   return d.companyId==c && (d.schemaVersion==1 || (k=='sites'&&d.schemaVersion==2)) && id.matches('^[a-zA-Z0-9_-]{1,128}$')
    && d.code is string && d.code.matches('^[A-Z0-9][A-Z0-9_-]{0,39}$')
    && (d.name is string && d.name.size()>0 && d.name.size()<=120) && (d.notes is string && d.notes.size()<=2000)
    && d.refCount is int && d.refCount>=0 && (d.status!='archived' || d.refCount==0)
    && d.revision is int && d.revision>0
    && d.witnessKind is string && d.witnessId is string
    && d.updatedBy==request.auth.uid && d.updatedAt==request.time
    && shape(k,d) && relations(c,k,id);
  }
  function facilityHistory(c,id) {
   let d=request.resource.data;
   let h=getAfter(/databases/$(database)/documents/companies/$(c)/facilities/$(id)/history/$(string(d.revision))).data;
   return h.revision==d.revision && h.condition==d.condition && h.status==d.status && h.actorUid==request.auth.uid && h.occurredAt==request.time;
  }
  function shape_clients(d) {return d.keys().hasOnly(['companyId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision', 'refCount', 'witnessKind', 'witnessId', 'code', 'name', 'notes', 'status', 'clientType', 'contactPerson', 'phone', 'email', 'address', 'country', 'vatNumber']) && d.status in ['active', 'archived'] && (d.clientType is string && d.clientType.size()<=200) && (d.contactPerson is string && d.contactPerson.size()<=200) && (d.phone is string && d.phone.size()<=200) && (d.email is string && d.email.size()<=200) && (d.address is string && d.address.size()<=2000) && (d.country is string && d.country.size()<=200) && (d.vatNumber is string && d.vatNumber.size()<=200) && d.clientType in ['Individual','Company'];}
  function shape_contracts(d) {return d.keys().hasOnly(['companyId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision', 'refCount', 'witnessKind', 'witnessId', 'code', 'name', 'notes', 'status', 'clientId', 'startDate', 'endDate', 'serviceDescription']) && d.status in ['draft', 'active', 'expired', 'archived'] && (d.clientId is string && d.clientId.matches('^[a-zA-Z0-9_-]{1,128}$')) && (d.startDate is string && d.startDate.size()<=200) && (d.endDate is string && d.endDate.size()<=200) && (d.serviceDescription is string && d.serviceDescription.size()<=2000) && calendar(d.startDate) && calendar(d.endDate) && d.startDate<=d.endDate;}
  function shape_sites(d) {return d.keys().hasOnly(['companyId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision', 'refCount', 'witnessKind', 'witnessId', 'code', 'name', 'notes', 'status', 'clientId', 'contractId', 'propertyType', 'address', 'country', 'city', 'timeZone', 'workingDays', 'opensAt', 'closesAt', 'contactPerson', 'phone', 'description']) && d.status in ['active', 'archived'] && ((d.schemaVersion==2 && !d.keys().hasAny(['clientId','contractId'])) || (d.schemaVersion==1 && d.clientId is string && d.clientId.matches('^[a-zA-Z0-9_-]{1,128}$') && d.contractId is string && (d.contractId=='' || d.contractId.matches('^[a-zA-Z0-9_-]{1,128}$')))) && (d.propertyType is string && d.propertyType.size()<=200) && (d.address is string && d.address.size()<=2000) && (d.country is string && d.country.size()<=200) && (d.city is string && d.city.size()<=200) && (d.timeZone is string && d.timeZone.size()<=200) && (d.workingDays is string && (d.workingDays=='' || (d.workingDays.split(',').size()<=7 && d.workingDays.split(',').toSet().hasOnly(['Mon','Tue','Wed','Thu','Fri','Sat','Sun'])))) && (d.opensAt is string && d.opensAt.size()<=200) && (d.closesAt is string && d.closesAt.size()<=200) && (d.contactPerson is string && d.contactPerson.size()<=200) && (d.phone is string && d.phone.size()<=200) && (d.description is string && d.description.size()<=2000) && d.propertyType in ['Residential tower','Commercial building','Villa','Warehouse','Hotel','Shopping mall','School','Hospital','Factory','Office','Outdoor property','Other'] && validZone(d.timeZone) && (d.opensAt=='' || d.opensAt.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')) && (d.closesAt=='' || d.closesAt.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));}
  function shape_locations(d) {return d.keys().hasOnly(['companyId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision', 'refCount', 'witnessKind', 'witnessId', 'code', 'name', 'notes', 'status', 'siteId', 'parentId', 'locationType', 'floorNumber', 'description']) && d.status in ['active', 'archived'] && (d.siteId is string && d.siteId.matches('^[a-zA-Z0-9_-]{1,128}$')) && (d.parentId is string && (d.parentId=='' || d.parentId.matches('^[a-zA-Z0-9_-]{1,128}$'))) && (d.locationType is string && d.locationType.size()<=200) && (d.floorNumber is string && d.floorNumber.size()<=200) && (d.description is string && d.description.size()<=2000) && d.locationType in ['Building','Floor','Zone','Room','Corridor','Parking','Outdoor area','Common area','Custom'];}
  function shape_facilityTypes(d) {return d.keys().hasOnly(['companyId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision', 'refCount', 'witnessKind', 'witnessId', 'code', 'name', 'notes', 'status', 'description']) && d.status in ['active', 'archived'] && (d.description is string && d.description.size()<=2000) && true;}
  function shape_facilities(d) {return d.keys().hasOnly(['companyId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision', 'refCount', 'witnessKind', 'witnessId', 'code', 'name', 'notes', 'status', 'siteId', 'locationId', 'typeId', 'condition', 'description']) && d.status in ['active', 'under_maintenance', 'out_of_service', 'archived'] && (d.siteId is string && d.siteId.matches('^[a-zA-Z0-9_-]{1,128}$')) && (d.locationId is string && d.locationId.matches('^[a-zA-Z0-9_-]{1,128}$')) && (d.typeId is string && d.typeId.matches('^[a-zA-Z0-9_-]{1,128}$')) && (d.condition is string && d.condition.size()<=200) && (d.description is string && d.description.size()<=2000) && d.condition in ['Excellent','Good','Fair','Poor','Critical'];}
  function shape(k,d) {return k=='clients' ? shape_clients(d) : k=='contracts' ? shape_contracts(d) : k=='sites' ? shape_sites(d) : k=='locations' ? shape_locations(d) : k=='facilityTypes' ? shape_facilityTypes(d) : k=='facilities' ? shape_facilities(d) : k=='contractAllocations'?shape_allocations(d):false;}

  // Allocations preserve their original contract/client and planned interval; no hard delete.
  function shape_allocations(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','contractId','siteId','locationId','allocationType','startDate','endDate','effectiveEndDate','clientIdSnapshot'])
   && d.status in ['draft','active','terminated','expired','archived']
   && d.contractId.matches('^[a-zA-Z0-9_-]{1,128}$') && d.siteId.matches('^[a-zA-Z0-9_-]{1,128}$') && d.clientIdSnapshot.matches('^[a-zA-Z0-9_-]{1,128}$')
   && d.locationId is string && (d.locationId==''||d.locationId.matches('^[a-zA-Z0-9_-]{1,128}$'))
   && d.allocationType in ['service_coverage','exclusive_occupancy','shared_occupancy'] && calendar(d.startDate)&&calendar(d.endDate)&&d.startDate<=d.endDate
   && (d.allocationType=='service_coverage'||(d.locationId!=''&&d.startDate.split('-')[0]==d.endDate.split('-')[0]))
   && d.effectiveEndDate is string && (d.effectiveEndDate==''||(calendar(d.effectiveEndDate)&&d.effectiveEndDate>=d.startDate&&d.effectiveEndDate<=d.endDate))
   && (d.status!='terminated'||d.effectiveEndDate!='') && (d.status in ['terminated','archived']||d.effectiveEndDate=='');}
  function allocationRelations(c,id){
   let d=request.resource.data;let old=exists(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(id))?get(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(id)).data:{};
   let was=old.get('status','archived') in ['draft','active'];let now=d.status in ['draft','active'];
   let targetKind=d.locationId==''?'sites':'locations';let targetId=d.locationId==''?d.siteId:d.locationId;
   return (was==now||(increment(c,'contractAllocations',id,'contracts',d.contractId,now?1:-1)&&increment(c,'contractAllocations',id,targetKind,targetId,now?1:-1)))
    && (!now||getAfter(/databases/$(database)/documents/companies/$(c)/$(targetKind)/$(targetId)).data.status!='archived')
    && (d.locationId==''||getAfter(/databases/$(database)/documents/companies/$(c)/locations/$(d.locationId)).data.siteId==d.siteId);
  }
  function allocationCounter(c,k,id){
   let d=request.resource.data;let old=exists(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(d.witnessId))?get(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(d.witnessId)).data:{};
   let after=getAfter(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(d.witnessId)).data;
   let was=old.get('status','archived') in ['draft','active'];let now=after.status in ['draft','active'];
   return k in ['contracts','sites','locations'] && was!=now && (k=='contracts'?after.contractId==id:k=='sites'?after.siteId==id&&after.locationId=='':after.locationId==id)
    && d.diff(resource.data).affectedKeys().hasOnly(['refCount','witnessKind','witnessId','updatedAt','updatedBy'])
    && d.refCount is int&&d.refCount==resource.data.refCount+(now?1:-1)&&d.refCount>=0&&d.updatedAt==request.time&&d.updatedBy==request.auth.uid;
  }
  function allocationUpdateShape(d,b){return d.diff(b).affectedKeys().hasOnly(['name','notes','status','effectiveEndDate','revision','updatedAt','updatedBy']) && d.status in ['draft','active','terminated','expired','archived'] && d.effectiveEndDate is string && (d.effectiveEndDate==b.effectiveEndDate||(calendar(d.effectiveEndDate)&&d.effectiveEndDate>=d.startDate&&d.effectiveEndDate<=d.endDate)) && (d.status!='terminated'||d.effectiveEndDate!='') && (d.status in ['terminated','archived']||d.effectiveEndDate=='');}
  function allocationValid(c,id,creating){let d=request.resource.data;return id.matches('^[a-zA-Z0-9_-]{1,128}$')&&d.companyId==c&&d.schemaVersion==1&&d.code.matches('^[A-Z0-9][A-Z0-9_-]{0,39}$')&&d.name is string&&d.name.size()>0&&d.name.size()<=120&&d.notes is string&&d.notes.size()<=2000&&d.refCount==0&&d.witnessKind==''&&d.witnessId==''&&d.updatedAt==request.time&&d.updatedBy==request.auth.uid&&(creating?shape_allocations(d):allocationUpdateShape(d,resource.data))&&allocationRelations(c,id);}
  function allocationSnapshot(d){return {'code':d.code,'name':d.name,'notes':d.notes,'status':d.status,'contractId':d.contractId,'siteId':d.siteId,'locationId':d.locationId,'allocationType':d.allocationType,'startDate':d.startDate,'endDate':d.endDate,'effectiveEndDate':d.effectiveEndDate,'clientIdSnapshot':d.clientIdSnapshot};}
  function slot(id,d){return {'allocationId':id,'startDate':d.startDate,'endDate':d.effectiveEndDate==''?d.endDate:d.effectiveEndDate,'allocationType':d.allocationType};}
  function allocationChange(c,id,creating){
   let d=request.resource.data;let b=creating?{}:resource.data;
   let contract=get(/databases/$(database)/documents/companies/$(c)/contracts/$(d.contractId)).data;
   let starting=creating||(b.status=='draft'&&d.status=='active');
   let reserving=d.allocationType!='service_coverage'&&((d.status=='active'&&(creating||b.status=='draft'))||(d.status=='terminated'&&b.status=='active'));
   let h=getAfter(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(id)/history/$(string(d.revision))).data;
   return (creating?d.status in ['draft','active']:(true
    && d.status in {'draft':['draft','active','archived'],'active':['active','terminated','expired'],'terminated':['terminated','archived'],'expired':['expired','archived'],'archived':['archived']}[b.status]
    && (d.effectiveEndDate==b.effectiveEndDate||(b.status=='active'&&d.status=='terminated'))))
    && (!starting||(contract.status=='active'&&d.clientIdSnapshot==contract.clientId&&d.startDate>=contract.startDate&&d.endDate<=contract.endDate))
    && h.snapshot==allocationSnapshot(d) && h.actorUid==request.auth.uid && h.occurredAt==request.time
    && (!reserving||calendarContains(c,id,d));
  }
  function calendarContains(c,id,d){let a=getAfter(/databases/$(database)/documents/companies/$(c)/occupancyCalendars/$(d.locationId+'_'+d.startDate.split('-')[0])).data;return a.witnessId==id&&slot(id,d) in a.slots;}
  function noConflict(a,b){return a.allocationId==b.allocationId||a.endDate<b.startDate||b.endDate<a.startDate||(a.allocationType=='shared_occupancy'&&b.allocationType=='shared_occupancy');}
  function validCalendar(c,id,creating){
   let d=request.resource.data;let b=creating?{'slots':[],'revision':0}:resource.data;
   let before=exists(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(d.witnessId))?get(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(d.witnessId)).data:{};
   let a=getAfter(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(d.witnessId)).data;let expected=slot(d.witnessId,a);
   return d.keys().hasOnly(['companyId','siteId','locationId','year','slots','revision','witnessId','updatedAt','updatedBy'])
    && d.companyId==c&&d.siteId==a.siteId&&d.locationId==a.locationId&&d.year==a.startDate.split('-')[0]&&id==d.locationId+'_'+d.year
    && d.updatedAt==request.time&&d.updatedBy==request.auth.uid&&d.revision==b.revision+1
    && a.allocationType!='service_coverage' && a.revision==before.get('revision',0)+1
    && ((a.status=='active'&&before.get('status','draft')=='draft')||(a.status=='terminated'&&before.status=='active'))
    && d.slots is list && d.slots.size()>0&&d.slots.size()<=12 && expected in d.slots
    && d.slots.size()==b.slots.size()+(a.status=='active'?1:0)
    && (creating||(d.siteId==b.siteId&&d.locationId==b.locationId&&d.year==b.year))
    && (a.status=='active'?(d.slots==b.slots.concat([expected]) && (b.slots.size()<=0||noConflict(b.slots[0],expected)) && (b.slots.size()<=1||noConflict(b.slots[1],expected)) && (b.slots.size()<=2||noConflict(b.slots[2],expected)) && (b.slots.size()<=3||noConflict(b.slots[3],expected)) && (b.slots.size()<=4||noConflict(b.slots[4],expected)) && (b.slots.size()<=5||noConflict(b.slots[5],expected)) && (b.slots.size()<=6||noConflict(b.slots[6],expected)) && (b.slots.size()<=7||noConflict(b.slots[7],expected)) && (b.slots.size()<=8||noConflict(b.slots[8],expected)) && (b.slots.size()<=9||noConflict(b.slots[9],expected)) && (b.slots.size()<=10||noConflict(b.slots[10],expected)) && (b.slots.size()<=11||noConflict(b.slots[11],expected))):d.slots==b.slots.removeAll([slot(d.witnessId,before)]).concat([expected]));}
  // ------------------------------------------------------------------ Phase 2
  // Masters reuse the Phase 1 metadata/code-claim contract. Counted references keep
  // archive protection; informational links are resolved by the transaction only.
  function live2(k,d){return d.get('status','archived')!='archived' && !(k in ['teamMembers','siteAssignments','shiftAssignments'] && d.get('status','')=='ended');}
  // The target's own counter rule verifies the exact +1/-1 (counterDelta). Here we only prove the target
  // was written in this same request by this witness: updatedAt==request.time cannot be stale.
  function touched2(c,k,id,t,tid,isNew){return touchedNow(getAfter(/databases/$(database)/documents/companies/$(c)/$(t)/$(tid)).data,k,id,isNew);}
  function touchedNow(a,k,id,isNew){return a.witnessKind==k && a.witnessId==id && a.updatedAt==request.time && (!isNew || a.status!='archived');}
  function ref2(c,k,id,field,t,creating){
   return refIds2(c,k,id,t,creating,(!creating && live2(k,resource.data)) ? resource.data.get(field,'') : '',live2(k,request.resource.data) ? request.resource.data.get(field,'') : '');
  }
  function refIds2(c,k,id,t,creating,oldId,newId){
   return oldId==newId || ((oldId=='' || touched2(c,k,id,t,oldId,false)) && (newId=='' || touched2(c,k,id,t,newId,true)));
  }
  function counter2Move(id,w,field,before,after){return counterDelta(live2(w,before) && before.get(field,'')==id, live2(w,after) && after.get(field,'')==id);}
  function extraAssignment(d){return (d.endDate=='' || d.endDate>=d.startDate) && (d.status!='ended' || d.endDate!='');}
  function extraStore(c,d){return d.locationId=='' || !live2('stores',d) || getAfter(/databases/$(database)/documents/companies/$(c)/locations/$(d.locationId)).data.siteId==d.siteId;}
  function extraParent(c,k,id,d){return d.parentId=='' || !live2(k,d) || (d.parentId!=id && getAfter(/databases/$(database)/documents/companies/$(c)/$(k)/$(d.parentId)).data.parentId=='');}
  function extraAsset(c,id,d){
   return (!live2('assets',d) || getAfter(/databases/$(database)/documents/companies/$(c)/locations/$(d.locationId)).data.siteId==d.siteId)
    && (d.trackingMode!='individual' || d.quantity=='1') && (d.trackingMode!='batch' || d.serialNumber=='')
    && (d.purchaseDate=='' || d.warrantyEndDate=='' || d.warrantyEndDate>=d.purchaseDate)
    && d.lastTransferId is string && (d.revision!=1 || assetHistory(c,id));
  }
  // Shared metadata checks; per-kind field, link and lifecycle checks are generated below.
  function business2(c,k,id){
   let d=request.resource.data;
   return d.companyId==c && d.schemaVersion==1 && id.matches('^[a-zA-Z0-9_-]{1,128}$')
    && (d.name is string && d.name.size()>0 && d.name.size()<=120) && (d.notes is string && d.notes.size()<=2000)
    && d.refCount is int && d.refCount>=0 && (d.status!='archived' || d.refCount==0)
    && d.revision is int && d.revision>0 && d.witnessKind is string && d.witnessId is string
    && d.updatedBy==request.auth.uid && d.updatedAt==request.time
    ;
  }
  function create2(c,k,id){
   let d=request.resource.data;
   return business2(c,k,id) && d.createdAt==request.time && d.createdBy==request.auth.uid
    && d.status!='archived' && d.revision==1 && d.refCount==0 && d.witnessKind=='' && d.witnessId==''
    && getAfter(/databases/$(database)/documents/companies/$(c)/codeClaims/$(k+'_'+d.code)).data.recordId==id
    && (k!='assets' || d.lastTransferId=='') && (!(k in ['employees','assets']) || quota(c,k,id));
  }
  function update2(c,k,id){
   let d=request.resource.data; let b=resource.data;
   return business2(c,k,id) && d.schemaVersion==b.schemaVersion
    && d.createdAt==b.createdAt && d.createdBy==b.createdBy && d.code==b.code && d.revision==b.revision+1
    && d.refCount==b.refCount && d.witnessKind==b.witnessKind && d.witnessId==b.witnessId;
  }
  // Assets move only with a new transfer record created in the same transaction.
  function assetMove(c,id,b,d){
   // Ordinary edits need a history snapshot; a move is recorded by its immutable transfer record instead.
   return (d.siteId==b.siteId && d.locationId==b.locationId && d.lastTransferId==b.lastTransferId && assetHistory(c,id))
    || (live2('assets',b) && d.lastTransferId!=b.lastTransferId
     && !exists(/databases/$(database)/documents/companies/$(c)/assetTransfers/$(d.lastTransferId))
     && transferMatches(getAfter(/databases/$(database)/documents/companies/$(c)/assetTransfers/$(d.lastTransferId)).data,id,b,d));
  }
  function transferMatches(t,id,b,d){return t.assetId==id && t.fromSiteId==b.siteId && t.fromLocationId==b.locationId && t.toSiteId==d.siteId && t.toLocationId==d.locationId && t.conditionBefore==b.condition && t.conditionAfter==d.condition && t.quantity==b.quantity;}
  function assetHistory(c,id){
   return assetHistoryMatches(request.resource.data,getAfter(/databases/$(database)/documents/companies/$(c)/assets/$(id)/history/$(string(request.resource.data.revision))).data);
  }
  function assetHistoryMatches(d,h){
   return h.revision==d.revision && h.condition==d.condition && h.status==d.status && h.siteId==d.siteId && h.locationId==d.locationId
    && h.custodianId==d.custodianId && h.quantity==d.quantity && h.transferId==d.lastTransferId && h.actorUid==request.auth.uid && h.occurredAt==request.time;
  }
  // Inventory: append-only movements; balances change only with a movement created in the same transaction.
  // Cheap date format check; exact calendar validity is also enforced by the shared client schema.
  function date2(v){return v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');}
  function storeActive(c,s){return s=='' || get(/databases/$(database)/documents/companies/$(c)/stores/$(s)).data.status=='active';}
  function balanceAfter(c,s,m,id,expected){return s=='' ? expected==-1 : balanceIs(getAfter(/databases/$(database)/documents/companies/$(c)/stockBalances/$(s+'_'+m)).data,id,expected);}
  function balanceIs(b,id,expected){return b.lastMovementId==id && b.quantity==expected;}
  function movementSides(c,id,d){
   let t=d.movementType;
   return t=='reversal'
    ? (id=='REV-'+d.reversesId && reversalMatches(get(/databases/$(database)/documents/companies/$(c)/stockMovements/$(d.reversesId)).data,d))
    : (d.reversesId=='' && storeActive(c,d.fromStoreId) && storeActive(c,d.toStoreId)
      && ((t in ['opening','receipt','adjustment_in'] && d.fromStoreId=='' && d.toStoreId!='')
       || (t in ['issue','adjustment_out'] && d.fromStoreId!='' && d.toStoreId=='')
       || (t=='transfer' && d.fromStoreId!='' && d.toStoreId!=''))
      && (!(t in ['adjustment_in','adjustment_out']) || d.reason.size()>0));
  }
  function reversalMatches(o,d){return o.movementType!='reversal' && o.materialId==d.materialId && o.fromStoreId==d.toStoreId && o.toStoreId==d.fromStoreId && o.quantity==d.quantity;}
  function optionalId(v){return v is string && (v=='' || v.matches('^[a-zA-Z0-9_-]{1,128}$'));}
  function movementValid(c,id){
   let d=request.resource.data;
   return d.keys().hasOnly(['companyId','schemaVersion','movementType','materialId','fromStoreId','toStoreId','quantity','movementDate','reason','reference','notes','issuedToEmployeeId','issuedToLocationId','reversesId','fromBalanceAfter','toBalanceAfter','createdAt','createdBy','workOrderId'])
    && d.companyId==c && d.schemaVersion==1 && id.matches('^[a-zA-Z0-9_-]{1,128}$') && born(d)
    && d.movementType in ['opening','receipt','issue','transfer','adjustment_in','adjustment_out','reversal']
    && d.quantity is int && d.quantity>0 && d.quantity<=1000000000000
    && d.materialId is string && d.materialId.matches('^[a-zA-Z0-9_-]{1,128}$') && optionalId(d.fromStoreId) && optionalId(d.toStoreId) && d.fromStoreId!=d.toStoreId
    && optionalId(d.issuedToEmployeeId) && optionalId(d.issuedToLocationId) && optionalId(d.reversesId) && optionalId(d.get('workOrderId',''))
    && d.movementDate is string && date2(d.movementDate)
    && d.reason is string && d.reason.size()<=500 && d.reference is string && d.reference.size()<=120 && d.notes is string && d.notes.size()<=2000
    && get(/databases/$(database)/documents/companies/$(c)/materials/$(d.materialId)).data.status=='active'
    && movementSides(c,id,d)
    && d.fromBalanceAfter is int && d.toBalanceAfter is int
    && balanceAfter(c,d.fromStoreId,d.materialId,id,d.fromBalanceAfter) && balanceAfter(c,d.toStoreId,d.materialId,id,d.toBalanceAfter);
  }
  function balanceValid(c,id,b,creating){
   return balanceMatches(c,id,b,creating,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(c)/stockMovements/$(request.resource.data.lastMovementId)).data);
  }
  function balanceMatches(c,id,b,creating,a,m){
   return a.keys().hasOnly(['companyId','storeId','materialId','quantity','revision','lastMovementId','updatedAt','updatedBy'])
    && a.companyId==c && a.storeId is string && a.materialId is string && id==a.storeId+'_'+a.materialId
    && a.quantity is int && a.quantity>=0 && a.revision==b.revision+1 && a.updatedAt==request.time && a.updatedBy==request.auth.uid
    && a.lastMovementId is string && a.lastMovementId.matches('^[a-zA-Z0-9_-]{1,128}$')
    && !exists(/databases/$(database)/documents/companies/$(c)/stockMovements/$(a.lastMovementId))
    && m.materialId==a.materialId && m.createdAt==request.time && (m.movementType!='opening' || creating)
    && ((m.toStoreId==a.storeId && a.quantity==b.quantity+m.quantity) || (m.fromStoreId==a.storeId && a.quantity==b.quantity-m.quantity));
  }
  function transferValid(c,tid){
   return transferData(c,tid,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(c)/assets/$(request.resource.data.assetId)).data,get(/databases/$(database)/documents/companies/$(c)/assets/$(request.resource.data.assetId)).data);
  }
  // Field equality (from/to/condition/quantity) is enforced once, by assetMove on the asset update
  // in the same transaction; this rule binds the immutable record to that asset move.
  function transferData(c,tid,t,a,b){
   return t.keys().hasOnly(['companyId','schemaVersion','assetId','fromSiteId','fromLocationId','toSiteId','toLocationId','quantity','transferDate','reason','conditionBefore','conditionAfter','receivedById','notes','actorUid','createdAt'])
    && t.companyId==c && t.schemaVersion==1 && t.actorUid==request.auth.uid && t.createdAt==request.time
    && a.lastTransferId==tid && b.lastTransferId!=tid
    && t.transferDate is string && date2(t.transferDate) && t.reason is string && t.reason.size()>0 && t.reason.size()<=500
    && t.notes is string && t.notes.size()<=2000 && optionalId(t.receivedById);
  }
  // ------------------------------------------------------------------ Phase 3 tasks
  // Template versions: drafts are editable; published versions are frozen except retirement.
  function versionContentOk(x){return x is map && x.keys().hasOnly(['title','instructions','priority','estimatedMinutes','approvalRequired','siteTypes','facilityTypeIds','assetCategoryIds','sections','questions','raci','assignment'])
   && x.title is string && x.title.size()>0 && x.title.size()<=120 && x.instructions is string && x.instructions.size()<=4000
   && x.priority in ['low','medium','high','critical'] && x.estimatedMinutes is int && x.estimatedMinutes>0 && x.estimatedMinutes<=1440 && x.approvalRequired is bool
   && x.questions is list && x.questions.size()<=100 && x.sections is list && x.sections.size()>0 && x.sections.size()<=20 && x.raci is list && x.raci.size()<=30
   && x.siteTypes is list && x.siteTypes.size()<=20 && x.facilityTypeIds is list && x.facilityTypeIds.size()<=20 && x.assetCategoryIds is list && x.assetCategoryIds.size()<=20 && x.assignment is map;}
  function versionKeys(d){return d.keys().hasOnly(['companyId','schemaVersion','templateId','version','state','content','revision','createdAt','createdBy','updatedAt','updatedBy','publishedAt','publishedBy','retiredAt']);}
  function versionCreate(c,id,d){
   return versionKeys(d) && d.companyId==c && d.schemaVersion==1 && d.version is int && d.version>0 && d.templateId is string && id==d.templateId+'-v'+string(d.version)
    && d.state=='draft' && d.revision==1 && born(d) && stamped(d)
    && d.publishedAt==null && d.publishedBy=='' && d.retiredAt==null && versionContentOk(d.content)
    && get(/databases/$(database)/documents/companies/$(c)/taskTemplates/$(d.templateId)).data.status=='active';
  }
  function versionUpdate(d,b){
   return versionKeys(d) && d.revision==b.revision+1 && stamped(d)
    && (b.state=='draft'
     ? (d.diff(b).affectedKeys().hasOnly(['content','state','publishedAt','publishedBy','revision','updatedAt','updatedBy']) && versionContentOk(d.content)
        && ((d.state=='draft' && d.publishedAt==null && d.publishedBy=='')
         || (d.state=='published' && d.publishedAt==request.time && d.publishedBy==request.auth.uid && d.content.questions.size()>0)))
     : (b.state=='published' && d.state=='retired' && d.retiredAt==request.time && d.diff(b).affectedKeys().hasOnly(['state','retiredAt','revision','updatedAt','updatedBy'])));
  }
  // Tasks: created from a published version snapshot; every status change is bound to a timeline event.
  function taskKeys(d){return d.keys().hasOnly(['companyId','schemaVersion','reference','title','templateId','versionId','version','content','approvalRequired','priority','siteId','locationId','facilityId','assetId','departmentId','assigneeIds','teamId','notes','plannedStart','dueAt','status','attempt','draftAnswers','occurrenceKey','cancelReason','exceptionCount','evidencePending','completedAt','createdAt','createdBy','updatedAt','updatedBy','revision','scheduleId','origin','startedAt','submittedAt']);}
  function placeOk(c,k,pid,site){return pid=='' || placeData(get(/databases/$(database)/documents/companies/$(c)/$(k)/$(pid)).data,site);}
  function placeData(x,site){return x.siteId==site && x.status!='archived';}
  function taskVersionOk(d,v){return v.state=='published' && v.templateId==d.templateId && v.version==d.version && d.content==v.content && d.approvalRequired==v.content.approvalRequired;}
  function eventOk(e,id,d,action,from){return e.taskId==id && e.revision==d.revision && e.action==action && e.fromStatus==from && e.toStatus==d.status && e.assigneeIds==d.assigneeIds && e.attempt==d.attempt && e.actorUid==request.auth.uid && e.at==request.time;}
  function taskCreate(c,id,d){
   return taskKeys(d) && d.companyId==c && d.schemaVersion==1 && d.revision==1 && d.attempt==1
    && born(d) && stamped(d)
    && d.reference is string && d.reference.size()>0 && d.reference.size()<=40 && d.title is string && d.title.size()>0 && d.title.size()<=160 && d.notes is string && d.notes.size()<=2000
    && d.priority in ['low','medium','high','critical'] && d.dueAt is timestamp && (d.plannedStart==null || (d.plannedStart is timestamp && d.plannedStart<=d.dueAt))
    && d.assigneeIds is list && d.assigneeIds.size()<=10 && ((d.status=='assigned' && d.assigneeIds.size()>0) || (d.status=='pending' && d.assigneeIds.size()==0))
    && d.draftAnswers=={} && taskOrigin(c,id,d) && d.cancelReason=='' && d.exceptionCount==0 && d.evidencePending==false && d.completedAt==null
    && (d.siteId+'~'+d.locationId+'~'+d.facilityId+'~'+d.assetId+'~'+d.departmentId+'~'+d.teamId).matches('^[a-zA-Z0-9_-]{1,128}(~[a-zA-Z0-9_-]{0,128}){5}$')
    && taskVersionOk(d,get(/databases/$(database)/documents/companies/$(c)/templateVersions/$(d.versionId)).data)
    && get(/databases/$(database)/documents/companies/$(c)/sites/$(d.siteId)).data.status!='archived'
    && placeOk(c,'locations',d.locationId,d.siteId) && placeOk(c,'facilities',d.facilityId,d.siteId) && placeOk(c,'assets',d.assetId,d.siteId)
    && eventOk(getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_1')).data,id,d,'create','');
  }
  // Manual tasks have no schedule; generated occurrences must use their schedule's deterministic key.
  function taskOrigin(c,id,d){
   return d.get('scheduleId','')=='' ? (d.occurrenceKey=='' && d.get('origin','manual')=='manual')
    : scheduledTask(id,d,get(/databases/$(database)/documents/companies/$(c)/recurringSchedules/$(d.scheduleId)).data);
  }
  function scheduledTask(id,d,s){
   return id=='occ_'+d.occurrenceKey && d.occurrenceKey.matches('^'+d.scheduleId+'_r'+string(s.ruleVersion)+'_[0-9]{12}$')
    && s.status=='active' && s.versionId==d.versionId && s.siteId==d.siteId && s.locationId==d.locationId && s.facilityId==d.facilityId && s.assetId==d.assetId
    && d.origin==(s.purpose=='maintenance' ? 'maintenance' : 'schedule');
  }
  function moveOk(a,f,t,appr){
   return a=='reschedule' ? (f in ['pending','assigned','paused','rework_required'] && t==f)
    : a=='assign' ? (f in ['pending','assigned','paused'] && t=='assigned')
    : a=='start' ? (f=='assigned' && t=='in_progress')
    : a=='pause' ? (f=='in_progress' && t=='paused')
    : a=='resume' ? (f=='paused' && t=='in_progress')
    : a=='submit' ? (f=='in_progress' && t==(appr ? 'awaiting_approval' : 'completed'))
    : a=='approve' ? (f=='awaiting_approval' && t=='completed')
    : a=='request_rework' ? (f=='awaiting_approval' && t=='rework_required')
    : a=='reject' ? (f=='awaiting_approval' && t=='rejected')
    : a=='restart' ? (f=='rework_required' && t=='in_progress')
    : a=='cancel' ? (f in ['pending','assigned','in_progress','paused','rework_required'] && t=='cancelled')
    : false;
  }
  function submissionOk(s,id,b){return s.taskId==id && s.attempt==b.attempt && s.submittedAt==request.time && s.submittedBy==request.auth.uid;}
  function decisionOk(x,a,attempt){return x.decision==a && x.attempt==attempt && x.decidedAt==request.time && x.reviewerUid==request.auth.uid;}
  function transitionOk(c,id,d,b,e){
   return eventOk(e,id,d,e.action,b.status) && moveOk(e.action,b.status,d.status,b.approvalRequired)
    && (e.action=='restart' ? (d.attempt==b.attempt+1 && d.draftAnswers=={}) : d.attempt==b.attempt)
    && (e.action=='cancel' ? (d.cancelReason is string && d.cancelReason.size()>0 && d.cancelReason.size()<=500) : d.cancelReason==b.cancelReason)
    && (e.action=='assign' ? (d.assigneeIds is list && d.assigneeIds.size()>0 && d.assigneeIds.size()<=10) : d.assigneeIds==b.assigneeIds)
    && (d.status=='completed' ? d.completedAt==request.time : d.completedAt==b.completedAt)
    && (e.action=='restart' || (e.action=='start' && b.get('startedAt',null)==null) ? d.get('startedAt',null)==request.time : d.get('startedAt',null)==b.get('startedAt',null))
    && (e.action=='submit' ? d.get('submittedAt',null)==request.time : d.get('submittedAt',null)==b.get('submittedAt',null))
    && (e.action=='reschedule' ? (d.dueAt is timestamp && (d.plannedStart==null || (d.plannedStart is timestamp && d.plannedStart<=d.dueAt))) : (d.plannedStart==b.plannedStart && d.dueAt==b.dueAt))
    && (e.action=='submit'
     ? (submissionOk(getAfter(/databases/$(database)/documents/companies/$(c)/taskSubmissions/$(id+'_'+string(b.attempt))).data,id,b)
        && d.draftAnswers=={} && d.exceptionCount is int && d.exceptionCount>=b.exceptionCount && d.evidencePending is bool)
     : (d.exceptionCount==b.exceptionCount && d.evidencePending==b.evidencePending && (d.draftAnswers==b.draftAnswers || e.action=='restart')))
    && (!(e.action in ['approve','request_rework','reject'])
     || decisionOk(getAfter(/databases/$(database)/documents/companies/$(c)/taskApprovals/$(id+'_'+string(b.attempt))).data,e.action,b.attempt));
  }
  function taskUpdate(c,id,d,b){
   return taskKeys(d) && d.revision==b.revision+1 && stamped(d)
    && ((d.status==b.status && b.status=='in_progress' && d.diff(b).affectedKeys().hasOnly(['draftAnswers','revision','updatedAt','updatedBy']) && d.draftAnswers is map && d.draftAnswers.size()<=120)
     || (d.diff(b).affectedKeys().hasOnly(['status','assigneeIds','attempt','draftAnswers','cancelReason','exceptionCount','evidencePending','completedAt','plannedStart','dueAt','startedAt','submittedAt','revision','updatedAt','updatedBy'])
        && transitionOk(c,id,d,b,getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_'+string(d.revision))).data)));
  }
  function eventCreate(c,eid,e,t){
   return e.keys().hasOnly(['companyId','schemaVersion','taskId','revision','action','fromStatus','toStatus','actorUid','at','note','assigneeIds','attempt'])
    && e.companyId==c && e.schemaVersion==1 && e.revision is int && eid==e.taskId+'_'+string(e.revision) && t.revision==e.revision && t.status==e.toStatus
    && e.action in ['create','assign','start','pause','resume','submit','approve','request_rework','reject','restart','cancel','reschedule']
    && e.actorUid==request.auth.uid && e.at==request.time && e.note is string && e.note.size()<=1000;
  }
  function submissionCreate(c,sid,s,t,b){
   return s.keys().hasOnly(['companyId','schemaVersion','taskId','attempt','versionId','answers','exceptions','evidencePending','remarks','siteId','locationId','facilityId','assetId','submittedBy','submittedAt'])
    && s.companyId==c && s.schemaVersion==1 && s.attempt is int && sid==s.taskId+'_'+string(s.attempt) && b.status=='in_progress' && t.attempt==s.attempt
    && t.status in ['awaiting_approval','completed'] && s.versionId==t.versionId && s.siteId==t.siteId && s.locationId==t.locationId && s.facilityId==t.facilityId && s.assetId==t.assetId
    && s.submittedBy==request.auth.uid && s.submittedAt==request.time && s.answers is map && s.answers.size()<=120
    && s.exceptions is list && s.exceptions.size()<=100 && s.evidencePending is list && s.evidencePending.size()<=100 && s.remarks is string && s.remarks.size()<=2000;
  }
  // No self-approval: the reviewer must differ from the submitter of the attempt.
  function approvalCreate(c,aid,x,t,b,s){
   return x.keys().hasOnly(['companyId','schemaVersion','taskId','attempt','decision','reason','reviewerUid','submittedBy','decidedAt'])
    && x.companyId==c && x.schemaVersion==1 && x.attempt is int && aid==x.taskId+'_'+string(x.attempt) && b.status=='awaiting_approval' && x.attempt==b.attempt
    && x.decision in ['approve','request_rework','reject'] && t.status==(x.decision=='approve' ? 'completed' : x.decision=='reject' ? 'rejected' : 'rework_required')
    && x.reviewerUid==request.auth.uid && x.decidedAt==request.time && x.reason is string && x.reason.size()<=1000 && (x.decision=='approve' || x.reason.size()>0)
    && x.submittedBy==s.submittedBy && s.submittedBy!=request.auth.uid;
  }
  function exceptionCreate(c,x,t){
   return x.keys().hasOnly(['companyId','schemaVersion','taskId','attempt','questionId','siteId','locationId','facilityId','assetId','type','severity','description','detectedBy','detectedAt','status','resolutionNote','revision','updatedAt','updatedBy'])
    && x.companyId==c && x.schemaVersion==1 && t.status!='cancelled' && x.attempt is int && x.attempt<=t.attempt
    && x.siteId==t.siteId && x.locationId==t.locationId && x.facilityId==t.facilityId && x.assetId==t.assetId
    && x.questionId is string && x.questionId.size()<=16 && x.type is string && x.type.size()>0 && x.type.size()<=60 && x.severity in ['warning','critical']
    && x.description is string && x.description.size()>0 && x.description.size()<=1000
    && x.detectedBy==request.auth.uid && x.detectedAt==request.time && x.status=='open' && x.resolutionNote=='' && x.revision==1 && x.updatedAt==request.time && x.updatedBy==request.auth.uid;
  }
  function exceptionUpdate(x,b){
   return x.diff(b).affectedKeys().hasOnly(['status','resolutionNote','revision','updatedAt','updatedBy']) && x.revision==b.revision+1
    && x.updatedAt==request.time && x.updatedBy==request.auth.uid && x.resolutionNote is string && x.resolutionNote.size()<=1000
    && ((b.status=='open' && x.status in ['acknowledged','closed']) || (b.status=='acknowledged' && x.status=='closed'));
  }
  // ------------------------------------------------------------------ Phase 4 scheduling
  function scheduleShape(c,d){
   return d.keys().hasOnly(['companyId','schemaVersion','code','name','purpose','templateId','versionId','siteId','locationId','facilityId','assetId','departmentId','assignment','rule','ruleVersion','startDate','endDate','localTime','durationMinutes','timeZone','workingDays','holidayPolicy','priority','status','generatedThrough','lastRunAt','lastRunStatus','lastError','retryCount','notes','createdAt','createdBy','updatedAt','updatedBy','revision'])
    && d.companyId==c && d.schemaVersion==1 && d.code is string && d.code.matches('^[A-Z0-9][A-Z0-9_-]{0,39}$') && d.name is string && d.name.size()>0 && d.name.size()<=120
    && d.purpose in ['routine','maintenance']
    && (d.templateId+'~'+d.versionId+'~'+d.siteId+'~'+d.locationId+'~'+d.facilityId+'~'+d.assetId+'~'+d.departmentId).matches('^[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{1,128}(~[a-zA-Z0-9_-]{0,128}){4}$')
    && d.rule is map && d.rule.keys().hasOnly(['type','interval','weekdays','monthDays','nth','nthWeekday','month','day','overflow'])
    && d.rule.type in ['once','daily','weekdays','weekly','monthly_dates','monthly_nth','yearly'] && d.rule.interval is int && d.rule.interval>=1 && d.rule.interval<=365
    && d.rule.weekdays is list && d.rule.weekdays.size()<=7 && d.rule.monthDays is list && d.rule.monthDays.size()<=31
    && d.ruleVersion is int && d.ruleVersion>=1 && date2(d.startDate) && d.endDate is string && (d.endDate=='' || (date2(d.endDate) && d.endDate>=d.startDate))
    && d.localTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.durationMinutes is int && d.durationMinutes>=5 && d.durationMinutes<=10080
    && d.timeZone is string && d.timeZone.size()>0 && d.timeZone.size()<=64 && d.workingDays is list && d.workingDays.size()<=7
    && d.holidayPolicy in ['skip','next_working_day','generate']
    && d.assignment is map && d.assignment.keys().hasOnly(['strategy','pool','refId','employeeIds','siteOnly'])
    && d.assignment.strategy in ['fixed','round_robin','least_workload','unassigned'] && d.assignment.pool in ['employee','department','designation','team','shift','site']
    && d.assignment.employeeIds is list && d.assignment.employeeIds.size()<=10 && d.assignment.siteOnly is bool && d.assignment.refId is string
    && d.priority in ['low','medium','high','critical'] && d.status in ['draft','active','paused','completed','archived']
    && d.generatedThrough is string && (d.generatedThrough=='' || date2(d.generatedThrough)) && (d.lastRunAt==null || d.lastRunAt is timestamp)
    && d.lastRunStatus in ['','ok','error'] && d.lastError is string && d.lastError.size()<=500 && d.retryCount is int && d.retryCount>=0
    && d.notes is string && d.notes.size()<=2000 && d.revision is int;
  }
  function publishedVersion(v,templateId){return v.state=='published' && v.templateId==templateId;}
  function scheduleCreate(c,d){
   return scheduleShape(c,d) && d.revision==1 && d.ruleVersion==1 && born(d) && stamped(d)
    && d.status in ['draft','active'] && d.generatedThrough=='' && d.lastRunAt==null && d.lastRunStatus=='' && d.retryCount==0
    && publishedVersion(get(/databases/$(database)/documents/companies/$(c)/templateVersions/$(d.versionId)).data,d.templateId)
    && get(/databases/$(database)/documents/companies/$(c)/sites/$(d.siteId)).data.status!='archived'
    && placeOk(c,'locations',d.locationId,d.siteId) && placeOk(c,'facilities',d.facilityId,d.siteId) && placeOk(c,'assets',d.assetId,d.siteId);
  }
  // Scheduler runs only record progress; admin edits bump the revision and may bump the rule version.
  function scheduleUpdate(c,d,b){
   return scheduleShape(c,d) && d.createdAt==b.createdAt && d.createdBy==b.createdBy && d.code==b.code && d.templateId==b.templateId && d.siteId==b.siteId && b.status!='archived'
    && ((d.diff(b).affectedKeys().hasOnly(['generatedThrough','lastRunAt','lastRunStatus','lastError','retryCount','status']) && d.lastRunAt==request.time
         && (d.status==b.status || (b.status=='active' && d.status=='completed')) && b.status=='active')
     || (d.revision==b.revision+1 && stamped(d)
         && (d.ruleVersion==b.ruleVersion || d.ruleVersion==b.ruleVersion+1)
         && (d.versionId==b.versionId || publishedVersion(get(/databases/$(database)/documents/companies/$(c)/templateVersions/$(d.versionId)).data,d.templateId))));
  }
  function runShape(d){
   return d.keys().hasOnly(['companyId','schemaVersion','mode','actorUid','startedAt','finishedAt','status','scheduleCount','created','existing','unassigned','notifications','errors','windowFrom','windowTo'])
    && d.mode in ['manual','server'] && d.status in ['running','ok','partial','error'] && d.scheduleCount is int && d.created is int && d.existing is int && d.unassigned is int && d.notifications is int
    && d.errors is list && d.errors.size()<=20 && d.windowFrom is string && d.windowTo is string;
  }
  // ------------------------------------------------------------------ Phase 4 cases
  function caseKeys(d){return d.keys().hasOnly(['companyId','schemaVersion','kind','number','title','description','status','priority','severity','category','siteId','locationId','facilityId','assetId','departmentId','targetDepartmentId','supervisorId','assigneeIds','sourceType','sourceId','parentId','level','reportedBy','clientId','contractId','workOrderId','complaintId','plannedDate','dueAt','slaPolicyId','responseDueAt','resolutionDueAt','respondedAt','resolvedAt','closedAt','resolution','notes','createdAt','createdBy','updatedAt','updatedBy','revision']);}
  function optTime(x){return x==null || x is timestamp;}
  function caseEventOk(e,k,id,d,a,from){return e.kind==k && e.caseId==id && e.revision==d.revision && e.action==a && e.fromStatus==from && e.toStatus==d.status && e.actorUid==request.auth.uid && e.at==request.time;}
  function caseCreate(c,k,id,d){
   return caseKeys(d) && d.companyId==c && d.schemaVersion==1 && d.kind==k && id.matches('^[a-zA-Z0-9_-]{1,128}$') && d.status==caseInitial(k)
    && d.revision==1 && born(d) && stamped(d)
    && d.number is string && d.number.size()>0 && d.number.size()<=40 && d.title is string && d.title.size()>0 && d.title.size()<=160
    && d.description is string && d.description.size()<=4000 && d.priority in ['low','medium','high','critical'] && d.severity in ['low','medium','high','critical']
    && d.category is string && d.category.size()<=60 && d.reportedBy is string && d.reportedBy.size()<=120 && d.notes is string && d.notes.size()<=2000 && d.resolution==''
    && (d.siteId+'~'+d.locationId+'~'+d.facilityId+'~'+d.assetId+'~'+d.departmentId+'~'+d.targetDepartmentId+'~'+d.supervisorId+'~'+d.sourceId+'~'+d.parentId+'~'+d.clientId+'~'+d.contractId+'~'+d.workOrderId+'~'+d.complaintId+'~'+d.slaPolicyId).matches('^[a-zA-Z0-9_-]{1,128}(~[a-zA-Z0-9_-]{0,128}){13}$')
    && d.sourceType in ['manual','task','task_exception','complaint','work_order','escalation','inspection','asset','admin','staff','client','service_request'] && d.level is int && d.level>=1 && d.level<=10
    && d.assigneeIds is list && d.assigneeIds.size()<=10 && (k!='escalations' || d.targetDepartmentId!='')
    && optTime(d.dueAt) && optTime(d.plannedDate) && optTime(d.responseDueAt) && optTime(d.resolutionDueAt) && d.respondedAt==null && d.resolvedAt==null && d.closedAt==null
    && get(/databases/$(database)/documents/companies/$(c)/sites/$(d.siteId)).data.status!='archived'
    && placeOk(c,'locations',d.locationId,d.siteId) && placeOk(c,'facilities',d.facilityId,d.siteId) && placeOk(c,'assets',d.assetId,d.siteId)
    && caseEventOk(getAfter(/databases/$(database)/documents/companies/$(c)/caseEvents/$(k+'_'+id+'_1')).data,k,id,d,'create','');
  }
  function caseUpdate(c,k,id,d,b){
   return caseKeys(d) && d.revision==b.revision+1 && stamped(d)
    && d.diff(b).affectedKeys().hasOnly(['status','assigneeIds','targetDepartmentId','respondedAt','resolvedAt','closedAt','resolution','workOrderId','notes','revision','updatedAt','updatedBy'])
    && caseStep(k,id,d,b,getAfter(/databases/$(database)/documents/companies/$(c)/caseEvents/$(k+'_'+id+'_'+string(d.revision))).data);
  }
  function caseStep(k,id,d,b,e){
   return caseEventOk(e,k,id,d,e.action,b.status)
    && (e.action=='link'
     ? (d.status==b.status && b.workOrderId=='' && d.workOrderId!='' && d.diff(b).affectedKeys().hasOnly(['workOrderId','revision','updatedAt','updatedBy']))
     : (caseMove(k,e.action,b.status,d.status) && d.workOrderId==b.workOrderId && d.notes==b.notes
        && (!caseReason(k,e.action) || e.note.size()>0)
        && (caseAssigns(k,e.action) ? (d.assigneeIds is list && d.assigneeIds.size()<=10) : d.assigneeIds==b.assigneeIds)
        && (caseRedirects(k,e.action) ? (d.targetDepartmentId is string && d.targetDepartmentId!='' && d.targetDepartmentId!=b.targetDepartmentId) : d.targetDepartmentId==b.targetDepartmentId)
        && ((caseResponds(k,e.action) && b.respondedAt==null) ? d.respondedAt==request.time : d.respondedAt==b.respondedAt)
        && (caseResolves(k,e.action) ? (d.resolvedAt==request.time && d.resolution is string && d.resolution.size()>0 && d.resolution.size()<=2000)
            : (caseReopens(k,e.action) ? (d.resolvedAt==null && d.resolution==b.resolution) : (d.resolvedAt==b.resolvedAt && d.resolution==b.resolution)))
        && (caseCloses(k,e.action) ? d.closedAt==request.time : (caseReopens(k,e.action) ? d.closedAt==null : d.closedAt==b.closedAt))));
  }
  function caseEventCreate(c,eid,e,x){
   return e.keys().hasOnly(['companyId','schemaVersion','kind','caseId','revision','action','fromStatus','toStatus','actorUid','at','note','assigneeIds','targetDepartmentId'])
    && e.companyId==c && e.schemaVersion==1 && e.kind in ['workOrders','complaints','escalations'] && e.revision is int && eid==e.kind+'_'+e.caseId+'_'+string(e.revision)
    && x.revision==e.revision && x.status==e.toStatus && e.actorUid==request.auth.uid && e.at==request.time && e.note is string && e.note.size()<=1000;
  }
  // ------------------------------------------------------------------ Phase 4 notifications
  function activeMember(c,uid){return get(/databases/$(database)/documents/companies/$(c)/members/$(uid)).data.status=='active';}
  function notificationCreate(c,d){
   return d.keys().hasOnly(['companyId','schemaVersion','recipientUid','type','title','body','recordKind','recordId','createdAt','createdBy','readAt'])
    && d.companyId==c && d.schemaVersion==1 && d.recipientUid is string && activeMember(c,d.recipientUid)
    && d.type in ['task_assigned','task_due_soon','task_overdue','task_reassigned','task_submitted','task_awaiting_approval','task_rejected','task_rework','work_order_created','work_order_assigned','escalation_raised','sla_breach','maintenance_due','complaint_created','task_approved','issue_updated']
    && d.title is string && d.title.size()>0 && d.title.size()<=160 && d.body is string && d.body.size()<=500
    && d.recordKind in ['tasks','workOrders','complaints','escalations','recurringSchedules'] && d.recordId is string && d.recordId.matches('^[a-zA-Z0-9_-]{1,128}$')
    && born(d) && d.readAt==null;
  }
  // ------------------------------------------------------------------ Phase 5 staff identity and scope
  // A staff login is linked to exactly one employee per company by an admin (staffLinks/{uid} + employeeLinks/{employeeId}).
  // Access needs: active membership, active link, active/probation employee and an active company. Document data is passed as arguments.
  function link(c){return get(/databases/$(database)/documents/companies/$(c)/staffLinks/$(request.auth.uid)).data;}
  function staffOk(c,m,l){return signedIn() && m.uid==request.auth.uid && m.companyId==c && m.status=='active' && m.role!='customer'
    && l.uid==request.auth.uid && l.status=='active' && get(/databases/$(database)/documents/companies/$(c)/employees/$(l.employeeId)).data.status in ['active','probation'] && activeCompany(c);}
  function staff(c){return staffOk(c,member(c),link(c));}
  function supervisorRole(m){return m.role in ['supervisor','site_manager','department_manager'];}
  function inScope(l,siteId){return l.allSites==true || siteId in l.siteIds;}
  function sees(m,l,t){return l.employeeId in t.assigneeIds || (supervisorRole(m) && inScope(l,t.siteId));}
  function staffView(c,t){return staffViewDoc(c,member(c),link(c),t);}
  function staffViewDoc(c,m,l,t){return staffOk(c,m,l) && sees(m,l,t);}
  // Assignees may run their own work in sites still in scope; supervisors may review, assign and reschedule within scope.
  function staffTaskUpdate(c,id,d,b){return staffActs(c,member(c),link(c),id,d,b);}
  function staffActs(c,m,l,id,d,b){
   return staffOk(c,m,l) && inScope(l,b.siteId) && taskUpdate(c,id,d,b)
    && ((l.employeeId in b.assigneeIds && (d.diff(b).affectedKeys().hasOnly(['draftAnswers','revision','updatedAt','updatedBy'])
         || getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_'+string(d.revision))).data.action in ['start','pause','resume','submit','restart']))
     || (supervisorRole(m) && getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_'+string(d.revision))).data.action in ['assign','approve','request_rework','reject','reschedule']));
  }
  function staffReviewer(c,t){return staffReviewerDoc(c,member(c),link(c),t);}
  function staffReviewerDoc(c,m,l,t){return staffOk(c,m,l) && supervisorRole(m) && inScope(l,t.siteId);}
  function staffSeesCase(m,l,x){return l.employeeId in x.assigneeIds || x.createdBy==request.auth.uid || (supervisorRole(m) && inScope(l,x.siteId));}
  function staffCase(c,x){return staffCaseDoc(c,member(c),link(c),x);}
  function staffCaseDoc(c,m,l,x){return staffOk(c,m,l) && staffSeesCase(m,l,x);}
  function staffCaseUpdate(c,k,id,d,b){return staffCaseActs(c,member(c),link(c),k,id,d,b);}
  function staffCaseActs(c,m,l,k,id,d,b){
   return staffOk(c,m,l) && inScope(l,b.siteId) && caseUpdate(c,k,id,d,b)
    && ((supervisorRole(m)) || (k=='workOrders' && l.employeeId in b.assigneeIds
     && getAfter(/databases/$(database)/documents/companies/$(c)/caseEvents/$(k+'_'+id+'_'+string(d.revision))).data.action in ['start','hold','resume','resolve','note']));
  }
  function staffCaseCreate(c,k,id,d){return staffCaseCreateDoc(c,member(c),link(c),k,id,d);}
  function staffCaseCreateDoc(c,m,l,k,id,d){
   return staffOk(c,m,l) && inScope(l,d.siteId) && caseCreate(c,k,id,d)
    && (k=='workOrders' ? d.sourceType in ['staff','task_exception'] : (supervisorRole(m) && k=='escalations'));
  }
  function staffMasterRead(c,kind,id,r){return staffMasterDoc(c,member(c),link(c),kind,id,r);}
  function staffMasterDoc(c,m,l,kind,id,r){
   return staffOk(c,m,l) && (kind=='sites' ? inScope(l,id)
    : kind in ['locations','facilities','assets'] ? inScope(l,r.siteId)
    : kind=='employees' ? (id==l.employeeId || (supervisorRole(m) && inScope(l,r.get('primarySiteId',''))))
    : kind in ['shiftAssignments','siteAssignments','leaveRecords','teamMembers'] ? r.employeeId==l.employeeId
    : kind in ['departments','designations','teams','shifts','holidays','taskCategories','slaPolicies']);
  }
  function linkShape(c,uid,d){
   return d.keys().hasOnly(['companyId','schemaVersion','uid','employeeId','siteIds','allSites','status','note','createdAt','createdBy','updatedAt','updatedBy','revision'])
    && d.companyId==c && d.schemaVersion==1 && d.uid==uid && d.employeeId is string && d.employeeId.matches('^[a-zA-Z0-9_-]{1,128}$')
    && d.siteIds is list && d.siteIds.size()<=10 && d.allSites is bool && d.status in ['active','revoked'] && d.note is string && d.note.size()<=500
    && d.revision is int && stamped(d);
  }
  function linkTarget(c,uid,d){
   return get(/databases/$(database)/documents/companies/$(c)/members/$(uid)).data.status=='active'
    && get(/databases/$(database)/documents/companies/$(c)/members/$(uid)).data.role!='customer'
    && get(/databases/$(database)/documents/companies/$(c)/employees/$(d.employeeId)).data.status in ['active','probation']
    && getAfter(/databases/$(database)/documents/companies/$(c)/employeeLinks/$(d.employeeId)).data.uid==uid;
  }
  // ------------------------------------------------------------------ Phase 6 field evidence and attendance
  function geo(x){return x==null || (x is map && x.keys().hasOnly(['lat','lng','accuracy','capturedAt']) && x.lat is number && x.lat>=-90 && x.lat<=90
    && x.lng is number && x.lng>=-180 && x.lng<=180 && x.accuracy is number && x.accuracy>0 && x.accuracy<=10000 && x.capturedAt is timestamp);}
  // The attendance date must be the caller's current local day (allowing every time zone).
  function today(date){
   let p=date.split('-');
   return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.time > timestamp.date(int(p[0]),int(p[1]),int(p[2])) - duration.value(15,'h')
    && request.time < timestamp.date(int(p[0]),int(p[1]),int(p[2])) + duration.value(39,'h');
  }
  function attendanceKeys(d){return d.keys().hasOnly(['companyId','schemaVersion','employeeId','uid','date','siteId','shiftId','checkInAt','checkInLocation','checkOutAt','checkOutLocation','status','lateMinutes','source','correction','revision','createdAt','updatedAt','updatedBy']);}
  function checkIn(c,m,l,id,d){
   return staffOk(c,m,l) && attendanceKeys(d) && d.companyId==c && d.schemaVersion==1 && d.employeeId==l.employeeId && d.uid==request.auth.uid
    && id==l.employeeId+'_'+d.date && today(d.date) && inScope(l,d.siteId) && d.shiftId is string && d.shiftId.size()<=128
    && d.checkInAt==request.time && geo(d.checkInLocation) && d.checkOutAt==null && d.checkOutLocation==null && d.status=='checked_in'
    && d.lateMinutes is int && d.source in ['mobile','web'] && d.correction==null && d.revision==1 && d.createdAt==request.time && stamped(d);
  }
  function checkOut(c,m,l,d,b){
   return staffOk(c,m,l) && b.uid==request.auth.uid && b.employeeId==l.employeeId && b.status=='checked_in'
    && d.diff(b).affectedKeys().hasOnly(['checkOutAt','checkOutLocation','status','revision','updatedAt','updatedBy'])
    && d.checkOutAt==request.time && geo(d.checkOutLocation) && d.status=='checked_out' && d.revision==b.revision+1 && stamped(d);
  }
  // Supervisors (in scope, never for themselves) and admins correct times with a reason.
  function correction(d,b){
   return attendanceKeys(d) && d.diff(b).affectedKeys().hasOnly(['checkInAt','checkOutAt','status','correction','revision','updatedAt','updatedBy'])
    && d.checkInAt is timestamp && (d.checkOutAt==null || (d.checkOutAt is timestamp && d.checkOutAt>d.checkInAt)) && d.status=='corrected'
    && d.correction is map && d.correction.keys().hasOnly(['reason','by','at']) && d.correction.reason is string && d.correction.reason.size()>0 && d.correction.reason.size()<=500
    && d.correction.by==request.auth.uid && d.correction.at==request.time && d.revision==b.revision+1 && stamped(d);
  }
  function supervisorFix(c,m,l,d,b){return staffOk(c,m,l) && supervisorRole(m) && inScope(l,b.siteId) && b.employeeId!=l.employeeId && correction(d,b);}
  // Verified QR/GPS evidence for one checklist question of one attempt (create-only).
  function evidenceCreate(c,m,l,id,x,t){
   return staffOk(c,m,l) && l.employeeId in t.assigneeIds && inScope(l,t.siteId) && t.status=='in_progress'
    && x.keys().hasOnly(['companyId','schemaVersion','taskId','attempt','questionId','type','refKind','refId','location','capturedAt','recordedAt','uid','employeeId','status'])
    && x.companyId==c && x.schemaVersion==1 && x.attempt==t.attempt && x.questionId is string && x.questionId.matches('^[a-zA-Z0-9_-]{1,16}$')
    && id==x.taskId+'_'+string(x.attempt)+'_'+x.questionId && x.uid==request.auth.uid && x.employeeId==l.employeeId && x.recordedAt==request.time && x.capturedAt is timestamp
    && (x.type=='qr'
      ? (x.status=='verified' && x.location==null && x.refKind in ['assets','locations','facilities'] && x.refId!=''
         && x.refId==(x.refKind=='assets' ? t.assetId : x.refKind=='locations' ? t.locationId : t.facilityId))
      : (x.type=='gps' && x.status=='recorded' && x.refKind=='' && x.refId=='' && x.location!=null && geo(x.location)));
  }
  // ------------------------------------------------------------------ Phase 7 customers, costs, compliance
  // A customer login (role "customer") is linked by an admin to one client; optional allocationIds narrow it further.
  // Customers never read internal master data: the link carries an admin-curated snapshot of the places they may see,
  // and request creation is checked against the real allocation server-side.
  function clink(c){return get(/databases/$(database)/documents/companies/$(c)/customerLinks/$(request.auth.uid)).data;}
  function customerOk(c,m,l){return signedIn() && m.uid==request.auth.uid && m.companyId==c && m.status=='active' && m.role=='customer'
    && l.uid==request.auth.uid && l.status=='active' && get(/databases/$(database)/documents/companies/$(c)/clients/$(l.clientId)).data.status!='archived' && activeCompany(c);}
  function customer(c){return customerOk(c,member(c),clink(c));}
  function customerScope(l,allocationId){return l.allocationIds.size()==0 || allocationId in l.allocationIds;}
  function customerSees(c,x){return customerSeesDoc(c,member(c),clink(c),x);}
  function customerSeesDoc(c,m,l,x){return customerOk(c,m,l) && x.clientId==l.clientId && customerScope(l,x.allocationId);}
  function dayStart(date){let p=date.split('-');return timestamp.date(int(p[0]),int(p[1]),int(p[2]));}
  // The allocation must belong to the customer's client, be active today and cover the requested place.
  function allocationGrants(l,a,d){
   return a.clientIdSnapshot==l.clientId && a.status=='active' && request.time>=dayStart(a.startDate) - duration.value(14,'h')
    && request.time<dayStart(a.get('effectiveEndDate','')!='' ? a.effectiveEndDate : a.endDate) + duration.value(38,'h')
    && a.contractId==d.contractId && a.siteId==d.siteId && (a.locationId=='' || a.locationId==d.locationId) && customerScope(l,d.allocationId);
  }
  function requestShape(c,d){
   return d.keys().hasOnly(['companyId','schemaVersion','clientId','contractId','allocationId','siteId','locationId','reference','category','priority','description','status','complaintId','workOrderId','timeline','resolutionSummary','remarks','confirmedAt','createdBy','createdAt','updatedAt','updatedBy','revision'])
    && d.companyId==c && d.schemaVersion==1 && d.reference is string && d.reference.size()>0 && d.reference.size()<=40
    && d.category is string && d.category.size()>0 && d.category.size()<=60 && d.priority in ['low','medium','high','critical']
    && d.description is string && d.description.size()>0 && d.description.size()<=2000
    && d.status in ['submitted','in_progress','resolved','closed','reopen_requested','cancelled']
    && d.timeline is list && d.timeline.size()<=40 && d.remarks is list && d.remarks.size()<=30
    && d.resolutionSummary is string && d.resolutionSummary.size()<=2000 && d.revision is int && stamped(d);
  }
  function requestCreate(c,m,l,d){
   return customerOk(c,m,l) && requestShape(c,d) && d.clientId==l.clientId && d.status=='submitted' && d.complaintId=='' && d.workOrderId==''
    && d.timeline.size()==1 && d.remarks.size()==0 && d.resolutionSummary=='' && d.confirmedAt==null && d.revision==1
    && d.createdBy==request.auth.uid && d.createdAt==request.time
    && allocationGrants(l,get(/databases/$(database)/documents/companies/$(c)/contractAllocations/$(d.allocationId)).data,d);
  }
  // Customers may add a remark, ask to reopen a resolved request, or confirm the resolution.
  function requestCustomerUpdate(c,m,l,d,b){
