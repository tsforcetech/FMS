  function update_teamMembers(c,id,d,b){return update2(c,'teamMembers',id) && shape_teamMembers(d) && extraAssignment(d) && ref2(c,'teamMembers',id,'teamId','teams',false) && ref2(c,'teamMembers',id,'employeeId','employees',false) && !d.diff(b).affectedKeys().hasAny(['teamId','employeeId']) && d.diff(b).affectedKeys().intersection(['teamId','employeeId'].toSet()).size()<=1 && (live2('teamMembers',b) || !live2('teamMembers',d));}
  function create_siteAssignments(c,id,d){return create2(c,'siteAssignments',id) && shape_siteAssignments(d) && extraAssignment(d) && ref2(c,'siteAssignments',id,'employeeId','employees',true) && ref2(c,'siteAssignments',id,'siteId','sites',true);}
  function update_siteAssignments(c,id,d,b){return update2(c,'siteAssignments',id) && shape_siteAssignments(d) && extraAssignment(d) && ref2(c,'siteAssignments',id,'employeeId','employees',false) && ref2(c,'siteAssignments',id,'siteId','sites',false) && !d.diff(b).affectedKeys().hasAny(['employeeId','siteId']) && d.diff(b).affectedKeys().intersection(['employeeId','siteId'].toSet()).size()<=1 && (live2('siteAssignments',b) || !live2('siteAssignments',d));}
  function create_shifts(c,id,d){return create2(c,'shifts',id) && shape_shifts(d) && d.startTime!=d.endTime && ref2(c,'shifts',id,'siteId','sites',true);}
  function update_shifts(c,id,d,b){return update2(c,'shifts',id) && shape_shifts(d) && d.startTime!=d.endTime && ref2(c,'shifts',id,'siteId','sites',false) && !d.diff(b).affectedKeys().hasAny(['siteId']);}
  function create_shiftAssignments(c,id,d){return create2(c,'shiftAssignments',id) && shape_shiftAssignments(d) && extraAssignment(d) && ref2(c,'shiftAssignments',id,'employeeId','employees',true) && ref2(c,'shiftAssignments',id,'shiftId','shifts',true);}
  function update_shiftAssignments(c,id,d,b){return update2(c,'shiftAssignments',id) && shape_shiftAssignments(d) && extraAssignment(d) && ref2(c,'shiftAssignments',id,'employeeId','employees',false) && ref2(c,'shiftAssignments',id,'shiftId','shifts',false) && !d.diff(b).affectedKeys().hasAny(['employeeId','shiftId']) && d.diff(b).affectedKeys().intersection(['employeeId','shiftId'].toSet()).size()<=1 && (live2('shiftAssignments',b) || !live2('shiftAssignments',d));}
  function create_holidays(c,id,d){return create2(c,'holidays',id) && shape_holidays(d) && true;}
  function update_holidays(c,id,d,b){return update2(c,'holidays',id) && shape_holidays(d) && true;}
  function create_leaveRecords(c,id,d){return create2(c,'leaveRecords',id) && shape_leaveRecords(d) && d.endDate>=d.startDate && true;}
  function update_leaveRecords(c,id,d,b){return update2(c,'leaveRecords',id) && shape_leaveRecords(d) && d.endDate>=d.startDate && true && !d.diff(b).affectedKeys().hasAny(['employeeId']);}
  function create_assetCategories(c,id,d){return create2(c,'assetCategories',id) && shape_assetCategories(d) && extraParent(c,'assetCategories',id,d) && ref2(c,'assetCategories',id,'parentId','assetCategories',true);}
  function update_assetCategories(c,id,d,b){return update2(c,'assetCategories',id) && shape_assetCategories(d) && extraParent(c,'assetCategories',id,d) && ref2(c,'assetCategories',id,'parentId','assetCategories',false);}
  function create_suppliers(c,id,d){return create2(c,'suppliers',id) && shape_suppliers(d) && true;}
  function update_suppliers(c,id,d,b){return update2(c,'suppliers',id) && shape_suppliers(d) && true;}
  function create_assets(c,id,d){return create2(c,'assets',id) && shape_assets(d) && extraAsset(c,id,d) && ref2(c,'assets',id,'categoryId','assetCategories',true) && ref2(c,'assets',id,'locationId','locations',true);}
  function update_assets(c,id,d,b){return update2(c,'assets',id) && shape_assets(d) && extraAsset(c,id,d) && ref2(c,'assets',id,'categoryId','assetCategories',false) && ref2(c,'assets',id,'locationId','locations',false) && !d.diff(b).affectedKeys().hasAny(['trackingMode']) && d.diff(b).affectedKeys().intersection(['categoryId','locationId'].toSet()).size()<=1 && assetMove(c,id,b,d);}
  function create_materialCategories(c,id,d){return create2(c,'materialCategories',id) && shape_materialCategories(d) && true;}
  function update_materialCategories(c,id,d,b){return update2(c,'materialCategories',id) && shape_materialCategories(d) && true;}
  function create_materials(c,id,d){return create2(c,'materials',id) && shape_materials(d) && ref2(c,'materials',id,'categoryId','materialCategories',true);}
  function update_materials(c,id,d,b){return update2(c,'materials',id) && shape_materials(d) && ref2(c,'materials',id,'categoryId','materialCategories',false) && !d.diff(b).affectedKeys().hasAny(['unit']);}
  function create_stores(c,id,d){return create2(c,'stores',id) && shape_stores(d) && extraStore(c,d) && ref2(c,'stores',id,'siteId','sites',true) && ref2(c,'stores',id,'locationId','locations',true);}
  function update_stores(c,id,d,b){return update2(c,'stores',id) && shape_stores(d) && extraStore(c,d) && ref2(c,'stores',id,'siteId','sites',false) && ref2(c,'stores',id,'locationId','locations',false) && !d.diff(b).affectedKeys().hasAny(['siteId']) && d.diff(b).affectedKeys().intersection(['siteId','locationId'].toSet()).size()<=1;}
  function create_taskCategories(c,id,d){return create2(c,'taskCategories',id) && shape_taskCategories(d) && ref2(c,'taskCategories',id,'parentId','taskCategories',true);}
  function update_taskCategories(c,id,d,b){return update2(c,'taskCategories',id) && shape_taskCategories(d) && ref2(c,'taskCategories',id,'parentId','taskCategories',false);}
  function create_taskTemplates(c,id,d){return create2(c,'taskTemplates',id) && shape_taskTemplates(d) && ref2(c,'taskTemplates',id,'categoryId','taskCategories',true);}
  function update_taskTemplates(c,id,d,b){return update2(c,'taskTemplates',id) && shape_taskTemplates(d) && ref2(c,'taskTemplates',id,'categoryId','taskCategories',false);}
  function create_slaPolicies(c,id,d){return create2(c,'slaPolicies',id) && shape_slaPolicies(d) && true;}
  function update_slaPolicies(c,id,d,b){return update2(c,'slaPolicies',id) && shape_slaPolicies(d) && true;}
  function counter_departments(c,id){return counterIn_departments(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_departments(c,id,w,wid){return w=='departments'?counter2Move(id,w,'parentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='designations'?counter2Move(id,w,'departmentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='employees'?counter2Move(id,w,'departmentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='teams'?counter2Move(id,w,'departmentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_designations(c,id){return counterIn_designations(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_designations(c,id,w,wid){return w=='employees'?counter2Move(id,w,'designationId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_employees(c,id){return counterIn_employees(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_employees(c,id,w,wid){return w=='teamMembers'?counter2Move(id,w,'employeeId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='siteAssignments'?counter2Move(id,w,'employeeId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='shiftAssignments'?counter2Move(id,w,'employeeId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_teams(c,id){return counterIn_teams(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_teams(c,id,w,wid){return w=='teamMembers'?counter2Move(id,w,'teamId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_teamMembers(c,id){return false;}
  function counter_siteAssignments(c,id){return false;}
  function counter_shifts(c,id){return counterIn_shifts(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_shifts(c,id,w,wid){return w=='shiftAssignments'?counter2Move(id,w,'shiftId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_shiftAssignments(c,id){return false;}
  function counter_holidays(c,id){return false;}
  function counter_leaveRecords(c,id){return false;}
  function counter_assetCategories(c,id){return counterIn_assetCategories(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_assetCategories(c,id,w,wid){return w=='assetCategories'?counter2Move(id,w,'parentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='assets'?counter2Move(id,w,'categoryId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_suppliers(c,id){return false;}
  function counter_assets(c,id){return false;}
  function counter_materialCategories(c,id){return counterIn_materialCategories(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_materialCategories(c,id,w,wid){return w=='materials'?counter2Move(id,w,'categoryId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_materials(c,id){return false;}
  function counter_stores(c,id){return false;}
  function counter_taskCategories(c,id){return counterIn_taskCategories(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_taskCategories(c,id,w,wid){return w=='taskCategories'?counter2Move(id,w,'parentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='taskTemplates'?counter2Move(id,w,'categoryId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_taskTemplates(c,id){return false;}
  function counter_slaPolicies(c,id){return false;}
  function counter_sites(c,id){return counterIn_sites(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_sites(c,id,w,wid){return w=='departments'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='siteAssignments'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='shifts'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='stores'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_locations(c,id){return counterIn_locations(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_locations(c,id,w,wid){return w=='assets'?counter2Move(id,w,'locationId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='stores'?counter2Move(id,w,'locationId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function caseMove(k,a,f,t){return k=='workOrders'?(a=='review'?(f in ['reported'] && t=='reviewed'):a=='assign'?(f in ['reported','reviewed','assigned','on_hold'] && t=='assigned'):a=='start'?(f in ['assigned'] && t=='in_progress'):a=='hold'?(f in ['assigned','in_progress'] && t=='on_hold'):a=='resume'?(f in ['on_hold'] && t=='in_progress'):a=='resolve'?(f in ['in_progress'] && t=='resolved'):a=='verify'?(f in ['resolved'] && t=='verified'):a=='close'?(f in ['resolved','verified'] && t=='closed'):a=='reopen'?(f in ['resolved','verified','closed'] && t=='in_progress'):a=='note'?(f in ['assigned','in_progress','on_hold'] && t==f):a=='cancel'?(f in ['reported','reviewed','assigned','on_hold'] && t=='cancelled'):false):k=='complaints'?(a=='assign'?(f in ['open','assigned'] && t=='assigned'):a=='start'?(f in ['assigned'] && t=='in_progress'):a=='resolve'?(f in ['assigned','in_progress'] && t=='resolved'):a=='close'?(f in ['resolved'] && t=='closed'):a=='reopen'?(f in ['resolved','closed'] && t=='in_progress'):a=='cancel'?(f in ['open','assigned'] && t=='cancelled'):false):k=='escalations'?(a=='acknowledge'?(f in ['raised'] && t=='acknowledged'):a=='reassign'?(f in ['raised','acknowledged','in_progress'] && t=='raised'):a=='start'?(f in ['acknowledged'] && t=='in_progress'):a=='resolve'?(f in ['acknowledged','in_progress'] && t=='resolved'):a=='close'?(f in ['resolved'] && t=='closed'):false):false;}
  function caseInitial(k){return k=='workOrders'?'reported':k=='complaints'?'open':k=='escalations'?'raised':'';}
  function caseReason(k,a){return k=='workOrders'?(a in ['hold','resolve','reopen','note','cancel']):k=='complaints'?(a in ['resolve','reopen','cancel']):k=='escalations'?(a in ['reassign','resolve']):false;}
  function caseAssigns(k,a){return k=='workOrders'?(a in ['assign']):k=='complaints'?(a in ['assign']):k=='escalations'?(a in ['acknowledge']):false;}
  function caseRedirects(k,a){return k=='workOrders'?(a in []):k=='complaints'?(a in []):k=='escalations'?(a in ['reassign']):false;}
  function caseResponds(k,a){return k=='workOrders'?(a in ['review','assign','start']):k=='complaints'?(a in ['assign','start','resolve']):k=='escalations'?(a in ['acknowledge','start','resolve']):false;}
  function caseResolves(k,a){return k=='workOrders'?(a in ['resolve']):k=='complaints'?(a in ['resolve']):k=='escalations'?(a in ['resolve']):false;}
  function caseReopens(k,a){return k=='workOrders'?(a in ['reopen']):k=='complaints'?(a in ['reopen']):k=='escalations'?(a in []):false;}
  function caseCloses(k,a){return k=='workOrders'?(a in ['close','cancel']):k=='complaints'?(a in ['close','cancel']):k=='escalations'?(a in ['close']):false;}
  // END GENERATED PHASE 2 VALIDATORS
  // ------------------------------------------------------------------ Phase 8 platform (Sharaco)
  match /platformEvents/{id} {
   allow read: if plat(['owner','billing','support','viewer']);
   allow create: if plat(['owner','billing','support']) && evNew(request.resource.data);
  }
  match /platformPlans/{id} {
   allow read: if signedIn();
   allow write: if plat(['owner','billing']) && platEvent(request.resource.data.eventId,'plan/'+id);
  }
  match /platformPlanVersions/{id} {
   allow read: if signedIn();
   allow create: if plat(['owner','billing']) && platEvent(request.resource.data.eventId,'plan/'+request.resource.data.planId);
  }
  match /platformSubs/{companyId} {
   allow read: if plat(['owner','billing','support','viewer']) || admin(companyId);
   allow write: if plat(['owner','billing']) && platEvent(request.resource.data.eventId,companyId);
  }
  match /platformInvoices/{id} {
   allow read: if plat(['owner','billing','viewer']) || admin(resource.data.companyId);
   allow write: if plat(['owner','billing']) && platEvent(request.resource.data.eventId,request.resource.data.companyId)
    && request.resource.data.get('source','manual')=='manual';
  }
  // Provider payment events are written only by a trusted backend after signature verification (not active on Spark).
  match /platformPayments/{id} {
   allow read: if plat(['owner','billing']);
  }
  match /users/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn() && request.auth.uid==uid && profileNew(uid,request.resource.data);
   allow update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['uid','displayName','schemaVersion','createdAt','updatedAt','createdBy','updatedBy'])
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt','updatedBy'])
    && request.resource.data.uid == uid
    && request.resource.data.schemaVersion == 1
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100
    && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == uid;
   match /companyAccess/{companyId} {
    // Discovery hints only. Every company request checks its canonical member document.
    allow get, list: if signedIn() && request.auth.uid == uid;
    allow create: if signedIn() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['companyId']) && request.resource.data.companyId==companyId
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/members/$(uid)).data.uid==uid;
   }
  }
  match /companies/{companyId} {
   allow get: if (admin(companyId) || staff(companyId) || customer(companyId)) && resource.data.companyId == companyId && resource.data.status in ['active','read_only'];
   // Phase 8: platform staff see the tenant directory record (not operational data); support only with a tenant-approved grant.
   allow read: if plat(['owner','billing','support','viewer']);
   allow create: if plat(['owner']) && coNew(companyId,request.resource.data);
   allow update: if plat(['owner','billing']) && coPlan(companyId,request.resource.data,resource.data);
   allow update: if aa(companyId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','timeZone','contactEmail','contactPhone','address','country','updatedAt','updatedBy'])
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120
    && validZone(request.resource.data.timeZone)
    && optionalContact(request.resource.data)
    && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
   match /members/{uid} {
    allow get: if signedIn() && resource.data.uid == uid && resource.data.companyId == companyId
     && (request.auth.uid == uid || (aa(companyId)));
    // Phase 2: owners/admins may list their company's members (read-only). Role changes stay trusted.
    allow list: if aa(companyId);
    // Phase 5: staff may find reviewers (query filtered by role) to notify them; no other member data is exposed.
    allow list: if staff(companyId) && resource.data.role in ['owner','admin','supervisor','site_manager','department_manager'];
    // Phase 8: a signed-in, email-verified person joins by accepting an invitation addressed to them (same transaction).
    allow create: if signedIn() && request.auth.uid==uid && joinOk(companyId,uid,request.resource.data);
   }
   match /invitations/{token} {
    allow read: if admin(companyId);
    allow get: if signedIn() && resource.data.email==request.auth.token.email;
    allow create: if token.matches('^[A-Za-z0-9_-]{24,64}$') && inviteShape(request.resource.data,companyId)
     && (aa(companyId) && (request.resource.data.role!='admin' || member(companyId).role=='owner') && request.resource.data.role!='owner'
      || plat(['owner']) && request.resource.data.role=='owner');
    allow update: if admin(companyId) && inviteRevoke(request.resource.data,resource.data) || signedIn() && inviteAccept(companyId,request.resource.data,resource.data);
   }
   match /staffLinks/{uid} {
    allow get: if signedIn() && request.auth.uid==uid && resource.data.uid==uid;
    allow read: if aa(companyId);
    allow create: if aa(companyId) && linkShape(companyId,uid,request.resource.data)
     && request.resource.data.status=='active' && request.resource.data.revision==1 && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid
     && linkTarget(companyId,uid,request.resource.data) && quota(companyId,'staffLinks',uid);
    allow update: if aa(companyId) && linkShape(companyId,uid,request.resource.data)
     && request.resource.data.revision==resource.data.revision+1 && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy
     && request.resource.data.employeeId==resource.data.employeeId
     && (request.resource.data.status=='revoked' || linkTarget(companyId,uid,request.resource.data));
   }
   match /employeeLinks/{employeeId} {
    allow read: if aa(companyId);
    // One login per employee: the claim can move only away from a revoked link.
    allow create: if aa(companyId) && request.resource.data.keys().hasOnly(['companyId','employeeId','uid'])
     && request.resource.data.companyId==companyId && request.resource.data.employeeId==employeeId
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/staffLinks/$(request.resource.data.uid)).data.employeeId==employeeId;
    allow update: if aa(companyId) && request.resource.data.keys().hasOnly(['companyId','employeeId','uid'])
     && request.resource.data.companyId==companyId && request.resource.data.employeeId==employeeId
     && get(/databases/$(database)/documents/companies/$(companyId)/staffLinks/$(resource.data.uid)).data.status=='revoked'
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/staffLinks/$(request.resource.data.uid)).data.employeeId==employeeId;
   }
   match /auditLogs/{eventId} {
    allow get: if aa(companyId) && resource.data.companyId == companyId;
   }

   match /codeClaims/{claimId} {
    allow get: if aa(companyId);
    allow create: if aa(companyId)
     && request.resource.data.keys().hasOnly(['kind','recordId','code','companyId'])
     && request.resource.data.companyId==companyId && (known(request.resource.data.kind)||known2(request.resource.data.kind)||request.resource.data.kind=='contractAllocations')
     && claimId==request.resource.data.kind+'_'+request.resource.data.code
     && !exists(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.recordId))
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.recordId)).data.code==request.resource.data.code;
   }
   match /{kind}/{id} {
    allow read: if (known(kind) || known2(kind)) && admin(companyId) && activeCompany(companyId);
    allow read: if kind in ['sites','locations','facilities','assets','employees','shiftAssignments','siteAssignments','leaveRecords','teamMembers','departments','designations','teams','shifts','holidays','taskCategories','slaPolicies']
     && staffMasterRead(companyId,kind,id,resource.data);
    allow create: if known(kind) && admin(companyId) && activeCompany(companyId)
     && business(companyId,kind,id) && (kind!='sites'||request.resource.data.schemaVersion==2)
     && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid
     && request.resource.data.status!='archived' && request.resource.data.revision==1 && request.resource.data.refCount==0
     && request.resource.data.witnessKind=='' && request.resource.data.witnessId==''
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/codeClaims/$(kind+'_'+request.resource.data.code)).data.recordId==id
     && (kind!='facilities' || facilityHistory(companyId,id)) && (kind!='contractAllocations'||allocationChange(companyId,id,true)) && (kind!='sites' || quota(companyId,kind,id));
    allow update: if known(kind) && admin(companyId) && activeCompany(companyId) && (
     request.resource.data.refCount!=resource.data.refCount ? (request.resource.data.witnessKind=='contractAllocations'?allocationCounter(companyId,kind,id):(known2(request.resource.data.witnessKind)?(kind=='sites'?counter_sites(companyId,id):kind=='locations'?counter_locations(companyId,id):false):counter(companyId,kind,id))) : (
      business(companyId,kind,id)
      && request.resource.data.schemaVersion==resource.data.schemaVersion
      && (kind!='sites'||(request.resource.data.get('clientId','')==resource.data.get('clientId','')&&request.resource.data.get('contractId','')==resource.data.get('contractId','')))
      && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy
      && request.resource.data.code==resource.data.code && request.resource.data.revision==resource.data.revision+1
      && request.resource.data.diff(resource.data).affectedKeys().intersection(['clientId','contractId','siteId','parentId','locationId','typeId'].toSet()).size()<=1
      && request.resource.data.refCount==resource.data.refCount && request.resource.data.witnessKind==resource.data.witnessKind && request.resource.data.witnessId==resource.data.witnessId
      && (!(kind in ['locations','facilities']) || request.resource.data.siteId==resource.data.siteId)
      && (kind!='contracts' || resource.data.refCount==0 || (request.resource.data.clientId==resource.data.clientId&&request.resource.data.startDate==resource.data.startDate&&request.resource.data.endDate==resource.data.endDate))
      && (kind!='facilities' || facilityHistory(companyId,id))
      && (kind!='contractAllocations'||allocationChange(companyId,id,false))
     ));
   }
   // ---------------------------------------------------------------- Phase 3 workflow
   match /templateVersions/{versionId} {
    allow read: if aa(companyId);
    allow create: if aa(companyId) && versionCreate(companyId,versionId,request.resource.data);
    allow update: if aa(companyId) && versionUpdate(request.resource.data,resource.data);
   }
   match /tasks/{taskId} {
    allow read: if aa(companyId);
    allow read: if staffView(companyId,resource.data);
    allow create: if aa(companyId) && taskCreate(companyId,taskId,request.resource.data);
