  function counter_teamMembers(c,id){return counterIn_teamMembers(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_teamMembers(c,id,w,wid){return false;}
  function counter_siteAssignments(c,id){return counterIn_siteAssignments(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_siteAssignments(c,id,w,wid){return false;}
  function counter_shifts(c,id){return counterIn_shifts(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_shifts(c,id,w,wid){return w=='shiftAssignments'?counter2Move(id,w,'shiftId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_shiftAssignments(c,id){return counterIn_shiftAssignments(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_shiftAssignments(c,id,w,wid){return false;}
  function counter_holidays(c,id){return counterIn_holidays(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_holidays(c,id,w,wid){return false;}
  function counter_leaveRecords(c,id){return counterIn_leaveRecords(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_leaveRecords(c,id,w,wid){return false;}
  function counter_assetCategories(c,id){return counterIn_assetCategories(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_assetCategories(c,id,w,wid){return w=='assetCategories'?counter2Move(id,w,'parentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='assets'?counter2Move(id,w,'categoryId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_suppliers(c,id){return counterIn_suppliers(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_suppliers(c,id,w,wid){return false;}
  function counter_assets(c,id){return counterIn_assets(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_assets(c,id,w,wid){return false;}
  function counter_materialCategories(c,id){return counterIn_materialCategories(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_materialCategories(c,id,w,wid){return w=='materials'?counter2Move(id,w,'categoryId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_materials(c,id){return counterIn_materials(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_materials(c,id,w,wid){return false;}
  function counter_stores(c,id){return counterIn_stores(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_stores(c,id,w,wid){return false;}
  function counter_taskCategories(c,id){return counterIn_taskCategories(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_taskCategories(c,id,w,wid){return w=='taskCategories'?counter2Move(id,w,'parentId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='taskTemplates'?counter2Move(id,w,'categoryId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_taskTemplates(c,id){return counterIn_taskTemplates(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_taskTemplates(c,id,w,wid){return false;}
  function counter_slaPolicies(c,id){return counterIn_slaPolicies(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_slaPolicies(c,id,w,wid){return false;}
  function counter_sites(c,id){return counterIn_sites(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_sites(c,id,w,wid){return w=='departments'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='siteAssignments'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='shifts'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='stores'?counter2Move(id,w,'siteId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function counter_locations(c,id){return counterIn_locations(c,id,request.resource.data.witnessKind,request.resource.data.witnessId);}
  function counterIn_locations(c,id,w,wid){return w=='assets'?counter2Move(id,w,'locationId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):w=='stores'?counter2Move(id,w,'locationId',witnessBefore(c,w,wid),witnessAfter(c,w,wid)):false;}
  function caseMove(k,a,f,t){return k=='workOrders'?(a=='review'?(f in ['reported'] && t=='reviewed'):a=='assign'?(f in ['reported','reviewed','assigned','on_hold'] && t=='assigned'):a=='start'?(f in ['assigned'] && t=='in_progress'):a=='hold'?(f in ['assigned','in_progress'] && t=='on_hold'):a=='resume'?(f in ['on_hold'] && t=='in_progress'):a=='resolve'?(f in ['in_progress'] && t=='resolved'):a=='verify'?(f in ['resolved'] && t=='verified'):a=='close'?(f in ['resolved','verified'] && t=='closed'):a=='reopen'?(f in ['resolved','verified','closed'] && t=='in_progress'):a=='note'?(f in ['assigned','in_progress','on_hold'] && t==f):a=='cancel'?(f in ['reported','reviewed','assigned','on_hold'] && t=='cancelled'):false):k=='complaints'?(a=='assign'?(f in ['open','assigned'] && t=='assigned'):a=='start'?(f in ['assigned'] && t=='in_progress'):a=='resolve'?(f in ['assigned','in_progress'] && t=='resolved'):a=='close'?(f in ['resolved'] && t=='closed'):a=='reopen'?(f in ['resolved','closed'] && t=='in_progress'):a=='cancel'?(f in ['open','assigned'] && t=='cancelled'):false):k=='escalations'?(a=='acknowledge'?(f in ['raised'] && t=='acknowledged'):a=='reassign'?(f in ['raised','acknowledged','in_progress'] && t=='raised'):a=='start'?(f in ['acknowledged'] && t=='in_progress'):a=='resolve'?(f in ['acknowledged','in_progress'] && t=='resolved'):a=='close'?(f in ['resolved'] && t=='closed'):false):false;}
  function caseInitial(k){return k=='workOrders'?'reported':k=='complaints'?'open':k=='escalations'?'raised':'';}
  function caseReason(k,a){return k=='workOrders'?(a in ['hold','resolve','reopen','note','cancel']):k=='complaints'?(a in ['resolve','reopen','cancel']):k=='escalations'?(a in ['reassign','resolve']):false;}
  function caseAssigns(k,a){return k=='workOrders'?(a in ['assign']):k=='complaints'?(a in ['assign']):k=='escalations'?(a in ['acknowledge']):false;}
  function caseRedirects(k,a){return k=='workOrders'?(a in []):k=='complaints'?(a in []):k=='escalations'?(a in ['reassign']):false;}
  function caseResponds(k,a){return k=='workOrders'?(a in ['review','assign','start']):k=='complaints'?(a in ['assign','start','resolve']):k=='escalations'?(a in ['acknowledge','start','resolve']):false;}
  function caseResolves(k,a){return k=='workOrders'?(a in ['resolve']):k=='complaints'?(a in ['resolve']):k=='escalations'?(a in ['resolve']):false;}
  function caseReopens(k,a){return k=='workOrders'?(a in ['reopen']):k=='complaints'?(a in ['reopen']):k=='escalations'?(a in []):false;}
  function caseCloses(k,a){return k=='workOrders'?(a in ['close','cancel']):k=='complaints'?(a in ['close','cancel']):k=='escalations'?(a in ['close']):false;}
  // END GENERATED PHASE 2 VALIDATORS
  match /users/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, create, delete: if false;
   allow update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['uid','displayName','schemaVersion','createdAt','updatedAt','createdBy','updatedBy'])
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt','updatedBy'])
    && request.resource.data.uid == uid
    && request.resource.data.schemaVersion == 1
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100
    && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == uid;
   match /companyAccess/{companyId} {
    // Discovery hints only. Every company request checks its canonical member document.
    allow get, list: if signedIn() && request.auth.uid == uid;
    allow write: if false;
   }
  }
  match /companies/{companyId} {
   allow get: if (admin(companyId) || staff(companyId)) && resource.data.companyId == companyId && resource.data.status == 'active';
   allow list, create, delete: if false;
   allow update: if admin(companyId) && activeCompany(companyId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','timeZone','contactEmail','contactPhone','address','country','updatedAt','updatedBy'])
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120
    && validZone(request.resource.data.timeZone)
    && optionalContact(request.resource.data)
    && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
   match /members/{uid} {
    allow get: if signedIn() && resource.data.uid == uid && resource.data.companyId == companyId
     && (request.auth.uid == uid || (admin(companyId) && activeCompany(companyId)));
    // Phase 2: owners/admins may list their company's members (read-only). Role changes stay trusted.
    allow list: if admin(companyId) && activeCompany(companyId);
    // Phase 5: staff may find reviewers (query filtered by role) to notify them; no other member data is exposed.
    allow list: if staff(companyId) && resource.data.role in ['owner','admin','supervisor','site_manager','department_manager'];
    allow write: if false;
   }
   match /staffLinks/{uid} {
    allow get: if signedIn() && request.auth.uid==uid && resource.data.uid==uid;
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && linkShape(companyId,uid,request.resource.data)
     && request.resource.data.status=='active' && request.resource.data.revision==1 && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid
     && linkTarget(companyId,uid,request.resource.data);
    allow update: if admin(companyId) && activeCompany(companyId) && linkShape(companyId,uid,request.resource.data)
     && request.resource.data.revision==resource.data.revision+1 && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy
     && request.resource.data.employeeId==resource.data.employeeId
     && (request.resource.data.status=='revoked' || linkTarget(companyId,uid,request.resource.data));
    allow delete: if false;
   }
   match /employeeLinks/{employeeId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    // One login per employee: the claim can move only away from a revoked link.
    allow create: if admin(companyId) && activeCompany(companyId) && request.resource.data.keys().hasOnly(['companyId','employeeId','uid'])
     && request.resource.data.companyId==companyId && request.resource.data.employeeId==employeeId
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/staffLinks/$(request.resource.data.uid)).data.employeeId==employeeId;
    allow update: if admin(companyId) && activeCompany(companyId) && request.resource.data.keys().hasOnly(['companyId','employeeId','uid'])
     && request.resource.data.companyId==companyId && request.resource.data.employeeId==employeeId
     && get(/databases/$(database)/documents/companies/$(companyId)/staffLinks/$(resource.data.uid)).data.status=='revoked'
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/staffLinks/$(request.resource.data.uid)).data.employeeId==employeeId;
    allow delete: if false;
   }
   match /auditLogs/{eventId} {
    allow get: if admin(companyId) && activeCompany(companyId) && resource.data.companyId == companyId;
    allow list, write: if false;
   }

   match /codeClaims/{claimId} {
    allow get: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && request.resource.data.keys().hasOnly(['kind','recordId','code','companyId'])
     && request.resource.data.companyId==companyId && (known(request.resource.data.kind)||known2(request.resource.data.kind)||request.resource.data.kind=='contractAllocations')
     && claimId==request.resource.data.kind+'_'+request.resource.data.code
     && !exists(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.recordId))
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.recordId)).data.code==request.resource.data.code;
    allow update,delete,list: if false;
   }
   match /{kind}/{id} {
    allow read: if (known(kind) || known2(kind)) && admin(companyId) && activeCompany(companyId);
    allow read: if kind in ['sites','locations','facilities','assets','employees','shiftAssignments','siteAssignments','leaveRecords','teamMembers','departments','designations','teams','shifts','holidays','taskCategories','slaPolicies']
     && staffMasterRead(companyId,kind,id,resource.data);
    allow create: if known(kind) && admin(companyId) && activeCompany(companyId)
     && business(companyId,kind,id) && (kind!='sites'||request.resource.data.schemaVersion==2)
     && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid
     && request.resource.data.status!='archived' && request.resource.data.revision==1 && request.resource.data.refCount==0
     && request.resource.data.witnessKind=='' && request.resource.data.witnessId==''
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/codeClaims/$(kind+'_'+request.resource.data.code)).data.recordId==id
     && (kind!='facilities' || facilityHistory(companyId,id)) && (kind!='contractAllocations'||allocationChange(companyId,id,true));
    allow update: if known(kind) && admin(companyId) && activeCompany(companyId) && (
     request.resource.data.refCount!=resource.data.refCount ? (request.resource.data.witnessKind=='contractAllocations'?allocationCounter(companyId,kind,id):(known2(request.resource.data.witnessKind)?(kind=='sites'?counter_sites(companyId,id):kind=='locations'?counter_locations(companyId,id):false):counter(companyId,kind,id))) : (
      business(companyId,kind,id)
      && request.resource.data.schemaVersion==resource.data.schemaVersion
      && (kind!='sites'||(request.resource.data.get('clientId','')==resource.data.get('clientId','')&&request.resource.data.get('contractId','')==resource.data.get('contractId','')))
      && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy
      && request.resource.data.code==resource.data.code && request.resource.data.revision==resource.data.revision+1
      && request.resource.data.diff(resource.data).affectedKeys().intersection(['clientId','contractId','siteId','parentId','locationId','typeId'].toSet()).size()<=1
      && request.resource.data.refCount==resource.data.refCount && request.resource.data.witnessKind==resource.data.witnessKind && request.resource.data.witnessId==resource.data.witnessId
      && (!(kind in ['locations','facilities']) || request.resource.data.siteId==resource.data.siteId)
      && (kind!='contracts' || resource.data.refCount==0 || (request.resource.data.clientId==resource.data.clientId&&request.resource.data.startDate==resource.data.startDate&&request.resource.data.endDate==resource.data.endDate))
      && (kind!='facilities' || facilityHistory(companyId,id))
      && (kind!='contractAllocations'||allocationChange(companyId,id,false))
     ));
    allow delete: if false;
   }
   // ---------------------------------------------------------------- Phase 3 workflow
   match /templateVersions/{versionId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && versionCreate(companyId,versionId,request.resource.data);
    allow update: if admin(companyId) && activeCompany(companyId) && versionUpdate(request.resource.data,resource.data);
    allow delete: if false;
   }
   match /tasks/{taskId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow read: if staffView(companyId,resource.data);
    allow create: if admin(companyId) && activeCompany(companyId) && taskCreate(companyId,taskId,request.resource.data);
    allow update: if admin(companyId) && activeCompany(companyId) && taskUpdate(companyId,taskId,request.resource.data,resource.data);
    allow update: if staffTaskUpdate(companyId,taskId,request.resource.data,resource.data);
    allow delete: if false;
   }
   match /taskEvents/{eventId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && eventCreate(companyId,eventId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data);
    allow get: if staffView(companyId,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(resource.data.taskId)).data);
    allow get: if resource==null && staff(companyId);
    allow create: if staffView(companyId,getAfter(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data)
     && eventCreate(companyId,eventId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data);
    allow update,delete: if false;
   }
   match /taskSubmissions/{submissionId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && submissionCreate(companyId,submissionId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data);
    allow get: if staffView(companyId,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(resource.data.taskId)).data);
    allow get: if resource==null && staff(companyId);
    allow create: if staffView(companyId,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data)
     && submissionCreate(companyId,submissionId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data);
    allow update,delete: if false;
   }
   match /taskApprovals/{approvalId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && approvalCreate(companyId,approvalId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data,get(/databases/$(database)/documents/companies/$(companyId)/taskSubmissions/$(approvalId)).data);
    allow get: if staffView(companyId,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(resource.data.taskId)).data);
    allow get: if resource==null && staff(companyId);
    allow create: if staffReviewer(companyId,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data)
     && approvalCreate(companyId,approvalId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data,get(/databases/$(database)/documents/companies/$(companyId)/taskSubmissions/$(approvalId)).data);
    allow update,delete: if false;
   }
   match /taskExceptions/{exceptionId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && exceptionCreate(companyId,request.resource.data,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data);
    allow create: if staffView(companyId,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data)
     && exceptionCreate(companyId,request.resource.data,get(/databases/$(database)/documents/companies/$(companyId)/tasks/$(request.resource.data.taskId)).data);
    // Staff see issues they reported; supervisors see issues in their sites.
    allow get: if resource==null && staff(companyId);
    allow read: if staff(companyId) && (resource.data.detectedBy==request.auth.uid || (supervisorRole(member(companyId)) && inScope(link(companyId),resource.data.siteId)));
    allow update: if admin(companyId) && activeCompany(companyId) && exceptionUpdate(request.resource.data,resource.data);
    allow update: if staffReviewer(companyId,resource.data) && exceptionUpdate(request.resource.data,resource.data);
    allow delete: if false;
   }
   // ---------------------------------------------------------------- Phase 4
   match /recurringSchedules/{scheduleId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && scheduleCreate(companyId,request.resource.data);
    allow update: if admin(companyId) && activeCompany(companyId) && scheduleUpdate(companyId,request.resource.data,resource.data);
    allow delete: if false;
   }
   match /schedulerRuns/{runId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && runShape(request.resource.data) && request.resource.data.companyId==companyId && request.resource.data.schemaVersion==1
     && request.resource.data.actorUid==request.auth.uid && request.resource.data.startedAt==request.time && request.resource.data.finishedAt==null && request.resource.data.status=='running';
    allow update: if admin(companyId) && activeCompany(companyId) && runShape(request.resource.data) && resource.data.status=='running' && resource.data.actorUid==request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finishedAt','scheduleCount','created','existing','unassigned','notifications','errors']) && request.resource.data.finishedAt==request.time;
    allow delete: if false;
   }
   match /caseEvents/{eventId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && caseEventCreate(companyId,eventId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.caseId)).data);
    allow get: if staffCase(companyId,get(/databases/$(database)/documents/companies/$(companyId)/$(resource.data.kind)/$(resource.data.caseId)).data);
    allow create: if staffCase(companyId,getAfter(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.caseId)).data) && caseEventCreate(companyId,eventId,request.resource.data,getAfter(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.caseId)).data);
    allow update,delete: if false;
   }
   match /notifications/{notificationId} {
    allow read: if signedIn() && resource.data.recipientUid==request.auth.uid && activeMember(companyId,request.auth.uid) && activeCompany(companyId);
    // Senders may only probe that a deterministic ID is still free (prevents duplicates); they never read content.
    allow get: if resource==null && (admin(companyId) || staff(companyId)) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && notificationCreate(companyId,request.resource.data);
    allow create: if staff(companyId) && notificationCreate(companyId,request.resource.data)
     && request.resource.data.type in ['task_submitted','task_awaiting_approval','task_approved','task_rejected','task_rework','task_assigned','task_reassigned','work_order_created','work_order_assigned','escalation_raised','issue_updated'];
    allow update: if signedIn() && resource.data.recipientUid==request.auth.uid && activeMember(companyId,request.auth.uid)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && resource.data.readAt==null && request.resource.data.readAt==request.time;
    allow delete: if false;
   }
   match /notificationPreferences/{uid} {
    allow read: if (signedIn() && request.auth.uid==uid && activeMember(companyId,uid)) || (admin(companyId) && activeCompany(companyId));
    allow write: if signedIn() && request.auth.uid==uid && activeMember(companyId,uid)
     && request.resource.data.keys().hasOnly(['companyId','uid','inApp','email','push','updatedAt'])
     && request.resource.data.companyId==companyId && request.resource.data.uid==uid && request.resource.data.inApp is map && request.resource.data.inApp.size()<=30
     && request.resource.data.email is bool && request.resource.data.push is bool && request.resource.data.updatedAt==request.time;
   }
   match /workOrders/{caseId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && caseCreate(companyId,'workOrders',caseId,request.resource.data);
    allow update: if admin(companyId) && activeCompany(companyId) && caseUpdate(companyId,'workOrders',caseId,request.resource.data,resource.data);
    allow read: if staffCase(companyId,resource.data);
    allow get: if resource==null && staff(companyId);
    allow create: if staffCaseCreate(companyId,'workOrders',caseId,request.resource.data);
    allow update: if staffCaseUpdate(companyId,'workOrders',caseId,request.resource.data,resource.data);
    allow delete: if false;
   }
   match /complaints/{caseId} {
