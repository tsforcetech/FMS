    && placeOk(c,'locations',d.locationId,d.siteId) && placeOk(c,'facilities',d.facilityId,d.siteId) && placeOk(c,'assets',d.assetId,d.siteId)
    && eventOk(getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_1')).data,id,d,'create','');
  }
  // Manual tasks have no schedule; generated occurrences must use their schedule's deterministic key.
  function taskOrigin(c,id,d){
   return d.get('scheduleId','')=='' ? (d.occurrenceKey=='' && d.get('origin','manual')=='manual')
    : scheduledTask(id,d,get(/databases/$(database)/documents/companies/$(c)/recurringSchedules/$(d.scheduleId)).data);
  }
  function scheduledTask(id,d,s){
   return id=='occ_'+d.occurrenceKey && d.occurrenceKey.matches('^'+d.scheduleId+'_r'+string(s.ruleVersion)+'_[0-9]{12}$')
    && s.status=='active' && s.versionId==d.versionId && s.siteId==d.siteId && s.locationId==d.locationId && s.facilityId==d.facilityId && s.assetId==d.assetId
    && d.origin==(s.purpose=='maintenance' ? 'maintenance' : 'schedule');
  }
  function moveOk(a,f,t,appr){
   return a=='reschedule' ? (f in ['pending','assigned','paused','rework_required'] && t==f)
    : a=='assign' ? (f in ['pending','assigned','paused'] && t=='assigned')
    : a=='start' ? (f=='assigned' && t=='in_progress')
    : a=='pause' ? (f=='in_progress' && t=='paused')
    : a=='resume' ? (f=='paused' && t=='in_progress')
    : a=='submit' ? (f=='in_progress' && t==(appr ? 'awaiting_approval' : 'completed'))
    : a=='approve' ? (f=='awaiting_approval' && t=='completed')
    : a=='request_rework' ? (f=='awaiting_approval' && t=='rework_required')
    : a=='reject' ? (f=='awaiting_approval' && t=='rejected')
    : a=='restart' ? (f=='rework_required' && t=='in_progress')
    : a=='cancel' ? (f in ['pending','assigned','in_progress','paused','rework_required'] && t=='cancelled')
    : false;
  }
  function submissionOk(s,id,b){return s.taskId==id && s.attempt==b.attempt && s.submittedAt==request.time && s.submittedBy==request.auth.uid;}
  function decisionOk(x,a,attempt){return x.decision==a && x.attempt==attempt && x.decidedAt==request.time && x.reviewerUid==request.auth.uid;}
  function transitionOk(c,id,d,b,e){
   return eventOk(e,id,d,e.action,b.status) && moveOk(e.action,b.status,d.status,b.approvalRequired)
    && (e.action=='restart' ? (d.attempt==b.attempt+1 && d.draftAnswers=={}) : d.attempt==b.attempt)
    && (e.action=='cancel' ? (d.cancelReason is string && d.cancelReason.size()>0 && d.cancelReason.size()<=500) : d.cancelReason==b.cancelReason)
    && (e.action=='assign' ? (d.assigneeIds is list && d.assigneeIds.size()>0 && d.assigneeIds.size()<=10) : d.assigneeIds==b.assigneeIds)
    && (d.status=='completed' ? d.completedAt==request.time : d.completedAt==b.completedAt)
    && (e.action=='reschedule' ? (d.dueAt is timestamp && (d.plannedStart==null || (d.plannedStart is timestamp && d.plannedStart<=d.dueAt))) : (d.plannedStart==b.plannedStart && d.dueAt==b.dueAt))
    && (e.action=='submit'
     ? (submissionOk(getAfter(/databases/$(database)/documents/companies/$(c)/taskSubmissions/$(id+'_'+string(b.attempt))).data,id,b)
        && d.draftAnswers=={} && d.exceptionCount is int && d.exceptionCount>=b.exceptionCount && d.evidencePending is bool)
     : (d.exceptionCount==b.exceptionCount && d.evidencePending==b.evidencePending && (d.draftAnswers==b.draftAnswers || e.action=='restart')))
    && (!(e.action in ['approve','request_rework','reject'])
     || decisionOk(getAfter(/databases/$(database)/documents/companies/$(c)/taskApprovals/$(id+'_'+string(b.attempt))).data,e.action,b.attempt));
  }
  function taskUpdate(c,id,d,b){
   return taskKeys(d) && d.revision==b.revision+1 && d.updatedAt==request.time && d.updatedBy==request.auth.uid
    && ((d.status==b.status && b.status=='in_progress' && d.diff(b).affectedKeys().hasOnly(['draftAnswers','revision','updatedAt','updatedBy']) && d.draftAnswers is map && d.draftAnswers.size()<=120)
     || (d.diff(b).affectedKeys().hasOnly(['status','assigneeIds','attempt','draftAnswers','cancelReason','exceptionCount','evidencePending','completedAt','plannedStart','dueAt','revision','updatedAt','updatedBy'])
        && transitionOk(c,id,d,b,getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_'+string(d.revision))).data)));
  }
  function eventCreate(c,eid,e,t){
   return e.keys().hasOnly(['companyId','schemaVersion','taskId','revision','action','fromStatus','toStatus','actorUid','at','note','assigneeIds','attempt'])
    && e.companyId==c && e.schemaVersion==1 && e.revision is int && eid==e.taskId+'_'+string(e.revision) && t.revision==e.revision && t.status==e.toStatus
    && e.action in ['create','assign','start','pause','resume','submit','approve','request_rework','reject','restart','cancel','reschedule']
    && e.actorUid==request.auth.uid && e.at==request.time && e.note is string && e.note.size()<=1000;
  }
  function submissionCreate(c,sid,s,t,b){
   return s.keys().hasOnly(['companyId','schemaVersion','taskId','attempt','versionId','answers','exceptions','evidencePending','remarks','siteId','locationId','facilityId','assetId','submittedBy','submittedAt'])
    && s.companyId==c && s.schemaVersion==1 && s.attempt is int && sid==s.taskId+'_'+string(s.attempt) && b.status=='in_progress' && t.attempt==s.attempt
    && t.status in ['awaiting_approval','completed'] && s.versionId==t.versionId && s.siteId==t.siteId && s.locationId==t.locationId && s.facilityId==t.facilityId && s.assetId==t.assetId
    && s.submittedBy==request.auth.uid && s.submittedAt==request.time && s.answers is map && s.answers.size()<=120
    && s.exceptions is list && s.exceptions.size()<=100 && s.evidencePending is list && s.evidencePending.size()<=100 && s.remarks is string && s.remarks.size()<=2000;
  }
  // No self-approval: the reviewer must differ from the submitter of the attempt.
  function approvalCreate(c,aid,x,t,b,s){
   return x.keys().hasOnly(['companyId','schemaVersion','taskId','attempt','decision','reason','reviewerUid','submittedBy','decidedAt'])
    && x.companyId==c && x.schemaVersion==1 && x.attempt is int && aid==x.taskId+'_'+string(x.attempt) && b.status=='awaiting_approval' && x.attempt==b.attempt
    && x.decision in ['approve','request_rework','reject'] && t.status==(x.decision=='approve' ? 'completed' : x.decision=='reject' ? 'rejected' : 'rework_required')
    && x.reviewerUid==request.auth.uid && x.decidedAt==request.time && x.reason is string && x.reason.size()<=1000 && (x.decision=='approve' || x.reason.size()>0)
    && x.submittedBy==s.submittedBy && s.submittedBy!=request.auth.uid;
  }
  function exceptionCreate(c,x,t){
   return x.keys().hasOnly(['companyId','schemaVersion','taskId','attempt','questionId','siteId','locationId','facilityId','assetId','type','severity','description','detectedBy','detectedAt','status','resolutionNote','revision','updatedAt','updatedBy'])
    && x.companyId==c && x.schemaVersion==1 && t.status!='cancelled' && x.attempt is int && x.attempt<=t.attempt
    && x.siteId==t.siteId && x.locationId==t.locationId && x.facilityId==t.facilityId && x.assetId==t.assetId
    && x.questionId is string && x.questionId.size()<=16 && x.type is string && x.type.size()>0 && x.type.size()<=60 && x.severity in ['warning','critical']
    && x.description is string && x.description.size()>0 && x.description.size()<=1000
    && x.detectedBy==request.auth.uid && x.detectedAt==request.time && x.status=='open' && x.resolutionNote=='' && x.revision==1 && x.updatedAt==request.time && x.updatedBy==request.auth.uid;
  }
  function exceptionUpdate(x,b){
   return x.diff(b).affectedKeys().hasOnly(['status','resolutionNote','revision','updatedAt','updatedBy']) && x.revision==b.revision+1
    && x.updatedAt==request.time && x.updatedBy==request.auth.uid && x.resolutionNote is string && x.resolutionNote.size()<=1000
    && ((b.status=='open' && x.status in ['acknowledged','closed']) || (b.status=='acknowledged' && x.status=='closed'));
  }
  // ------------------------------------------------------------------ Phase 4 scheduling
  function scheduleShape(c,d){
   return d.keys().hasOnly(['companyId','schemaVersion','code','name','purpose','templateId','versionId','siteId','locationId','facilityId','assetId','departmentId','assignment','rule','ruleVersion','startDate','endDate','localTime','durationMinutes','timeZone','workingDays','holidayPolicy','priority','status','generatedThrough','lastRunAt','lastRunStatus','lastError','retryCount','notes','createdAt','createdBy','updatedAt','updatedBy','revision'])
    && d.companyId==c && d.schemaVersion==1 && d.code is string && d.code.matches('^[A-Z0-9][A-Z0-9_-]{0,39}$') && d.name is string && d.name.size()>0 && d.name.size()<=120
    && d.purpose in ['routine','maintenance']
    && (d.templateId+'~'+d.versionId+'~'+d.siteId+'~'+d.locationId+'~'+d.facilityId+'~'+d.assetId+'~'+d.departmentId).matches('^[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{1,128}(~[a-zA-Z0-9_-]{0,128}){4}$')
    && d.rule is map && d.rule.keys().hasOnly(['type','interval','weekdays','monthDays','nth','nthWeekday','month','day','overflow'])
    && d.rule.type in ['once','daily','weekdays','weekly','monthly_dates','monthly_nth','yearly'] && d.rule.interval is int && d.rule.interval>=1 && d.rule.interval<=365
    && d.rule.weekdays is list && d.rule.weekdays.size()<=7 && d.rule.monthDays is list && d.rule.monthDays.size()<=31
    && d.ruleVersion is int && d.ruleVersion>=1 && date2(d.startDate) && d.endDate is string && (d.endDate=='' || (date2(d.endDate) && d.endDate>=d.startDate))
    && d.localTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.durationMinutes is int && d.durationMinutes>=5 && d.durationMinutes<=10080
    && d.timeZone is string && d.timeZone.size()>0 && d.timeZone.size()<=64 && d.workingDays is list && d.workingDays.size()<=7
    && d.holidayPolicy in ['skip','next_working_day','generate']
    && d.assignment is map && d.assignment.keys().hasOnly(['strategy','pool','refId','employeeIds','siteOnly'])
    && d.assignment.strategy in ['fixed','round_robin','least_workload','unassigned'] && d.assignment.pool in ['employee','department','designation','team','shift','site']
    && d.assignment.employeeIds is list && d.assignment.employeeIds.size()<=10 && d.assignment.siteOnly is bool && d.assignment.refId is string
    && d.priority in ['low','medium','high','critical'] && d.status in ['draft','active','paused','completed','archived']
    && d.generatedThrough is string && (d.generatedThrough=='' || date2(d.generatedThrough)) && (d.lastRunAt==null || d.lastRunAt is timestamp)
    && d.lastRunStatus in ['','ok','error'] && d.lastError is string && d.lastError.size()<=500 && d.retryCount is int && d.retryCount>=0
    && d.notes is string && d.notes.size()<=2000 && d.revision is int;
  }
  function publishedVersion(v,templateId){return v.state=='published' && v.templateId==templateId;}
  function scheduleCreate(c,d){
   return scheduleShape(c,d) && d.revision==1 && d.ruleVersion==1 && d.createdAt==request.time && d.createdBy==request.auth.uid && d.updatedAt==request.time && d.updatedBy==request.auth.uid
    && d.status in ['draft','active'] && d.generatedThrough=='' && d.lastRunAt==null && d.lastRunStatus=='' && d.retryCount==0
    && publishedVersion(get(/databases/$(database)/documents/companies/$(c)/templateVersions/$(d.versionId)).data,d.templateId)
    && get(/databases/$(database)/documents/companies/$(c)/sites/$(d.siteId)).data.status!='archived'
    && placeOk(c,'locations',d.locationId,d.siteId) && placeOk(c,'facilities',d.facilityId,d.siteId) && placeOk(c,'assets',d.assetId,d.siteId);
  }
  // Scheduler runs only record progress; admin edits bump the revision and may bump the rule version.
  function scheduleUpdate(c,d,b){
   return scheduleShape(c,d) && d.createdAt==b.createdAt && d.createdBy==b.createdBy && d.code==b.code && d.templateId==b.templateId && d.siteId==b.siteId && b.status!='archived'
    && ((d.diff(b).affectedKeys().hasOnly(['generatedThrough','lastRunAt','lastRunStatus','lastError','retryCount','status']) && d.lastRunAt==request.time
         && (d.status==b.status || (b.status=='active' && d.status=='completed')) && b.status=='active')
     || (d.revision==b.revision+1 && d.updatedAt==request.time && d.updatedBy==request.auth.uid
         && (d.ruleVersion==b.ruleVersion || d.ruleVersion==b.ruleVersion+1)
         && (d.versionId==b.versionId || publishedVersion(get(/databases/$(database)/documents/companies/$(c)/templateVersions/$(d.versionId)).data,d.templateId))));
  }
  function runShape(d){
   return d.keys().hasOnly(['companyId','schemaVersion','mode','actorUid','startedAt','finishedAt','status','scheduleCount','created','existing','unassigned','notifications','errors','windowFrom','windowTo'])
    && d.mode in ['manual','server'] && d.status in ['running','ok','partial','error'] && d.scheduleCount is int && d.created is int && d.existing is int && d.unassigned is int && d.notifications is int
    && d.errors is list && d.errors.size()<=20 && d.windowFrom is string && d.windowTo is string;
  }
  // ------------------------------------------------------------------ Phase 4 cases
  function caseKeys(d){return d.keys().hasOnly(['companyId','schemaVersion','kind','number','title','description','status','priority','severity','category','siteId','locationId','facilityId','assetId','departmentId','targetDepartmentId','supervisorId','assigneeIds','sourceType','sourceId','parentId','level','reportedBy','clientId','contractId','workOrderId','complaintId','plannedDate','dueAt','slaPolicyId','responseDueAt','resolutionDueAt','respondedAt','resolvedAt','closedAt','resolution','notes','createdAt','createdBy','updatedAt','updatedBy','revision']);}
  function optTime(x){return x==null || x is timestamp;}
  function caseEventOk(e,k,id,d,a,from){return e.kind==k && e.caseId==id && e.revision==d.revision && e.action==a && e.fromStatus==from && e.toStatus==d.status && e.actorUid==request.auth.uid && e.at==request.time;}
  function caseCreate(c,k,id,d){
   return caseKeys(d) && d.companyId==c && d.schemaVersion==1 && d.kind==k && id.matches('^[a-zA-Z0-9_-]{1,128}$') && d.status==caseInitial(k)
    && d.revision==1 && d.createdAt==request.time && d.createdBy==request.auth.uid && d.updatedAt==request.time && d.updatedBy==request.auth.uid
    && d.number is string && d.number.size()>0 && d.number.size()<=40 && d.title is string && d.title.size()>0 && d.title.size()<=160
    && d.description is string && d.description.size()<=4000 && d.priority in ['low','medium','high','critical'] && d.severity in ['low','medium','high','critical']
    && d.category is string && d.category.size()<=60 && d.reportedBy is string && d.reportedBy.size()<=120 && d.notes is string && d.notes.size()<=2000 && d.resolution==''
    && (d.siteId+'~'+d.locationId+'~'+d.facilityId+'~'+d.assetId+'~'+d.departmentId+'~'+d.targetDepartmentId+'~'+d.supervisorId+'~'+d.sourceId+'~'+d.parentId+'~'+d.clientId+'~'+d.contractId+'~'+d.workOrderId+'~'+d.complaintId+'~'+d.slaPolicyId).matches('^[a-zA-Z0-9_-]{1,128}(~[a-zA-Z0-9_-]{0,128}){13}$')
    && d.sourceType in ['manual','task','task_exception','complaint','work_order','escalation','inspection','asset','admin','staff','client'] && d.level is int && d.level>=1 && d.level<=10
    && d.assigneeIds is list && d.assigneeIds.size()<=10 && (k!='escalations' || d.targetDepartmentId!='')
    && optTime(d.dueAt) && optTime(d.plannedDate) && optTime(d.responseDueAt) && optTime(d.resolutionDueAt) && d.respondedAt==null && d.resolvedAt==null && d.closedAt==null
    && get(/databases/$(database)/documents/companies/$(c)/sites/$(d.siteId)).data.status!='archived'
    && placeOk(c,'locations',d.locationId,d.siteId) && placeOk(c,'facilities',d.facilityId,d.siteId) && placeOk(c,'assets',d.assetId,d.siteId)
    && caseEventOk(getAfter(/databases/$(database)/documents/companies/$(c)/caseEvents/$(k+'_'+id+'_1')).data,k,id,d,'create','');
  }
  function caseUpdate(c,k,id,d,b){
   return caseKeys(d) && d.revision==b.revision+1 && d.updatedAt==request.time && d.updatedBy==request.auth.uid
    && d.diff(b).affectedKeys().hasOnly(['status','assigneeIds','targetDepartmentId','respondedAt','resolvedAt','closedAt','resolution','workOrderId','notes','revision','updatedAt','updatedBy'])
    && caseStep(k,id,d,b,getAfter(/databases/$(database)/documents/companies/$(c)/caseEvents/$(k+'_'+id+'_'+string(d.revision))).data);
  }
  function caseStep(k,id,d,b,e){
   return caseEventOk(e,k,id,d,e.action,b.status)
    && (e.action=='link'
     ? (d.status==b.status && b.workOrderId=='' && d.workOrderId!='' && d.diff(b).affectedKeys().hasOnly(['workOrderId','revision','updatedAt','updatedBy']))
     : (caseMove(k,e.action,b.status,d.status) && d.workOrderId==b.workOrderId && d.notes==b.notes
        && (!caseReason(k,e.action) || e.note.size()>0)
        && (caseAssigns(k,e.action) ? (d.assigneeIds is list && d.assigneeIds.size()<=10) : d.assigneeIds==b.assigneeIds)
        && (caseRedirects(k,e.action) ? (d.targetDepartmentId is string && d.targetDepartmentId!='' && d.targetDepartmentId!=b.targetDepartmentId) : d.targetDepartmentId==b.targetDepartmentId)
        && ((caseResponds(k,e.action) && b.respondedAt==null) ? d.respondedAt==request.time : d.respondedAt==b.respondedAt)
        && (caseResolves(k,e.action) ? (d.resolvedAt==request.time && d.resolution is string && d.resolution.size()>0 && d.resolution.size()<=2000)
            : (caseReopens(k,e.action) ? (d.resolvedAt==null && d.resolution==b.resolution) : (d.resolvedAt==b.resolvedAt && d.resolution==b.resolution)))
        && (caseCloses(k,e.action) ? d.closedAt==request.time : (caseReopens(k,e.action) ? d.closedAt==null : d.closedAt==b.closedAt))));
  }
  function caseEventCreate(c,eid,e,x){
   return e.keys().hasOnly(['companyId','schemaVersion','kind','caseId','revision','action','fromStatus','toStatus','actorUid','at','note','assigneeIds','targetDepartmentId'])
    && e.companyId==c && e.schemaVersion==1 && e.kind in ['workOrders','complaints','escalations'] && e.revision is int && eid==e.kind+'_'+e.caseId+'_'+string(e.revision)
    && x.revision==e.revision && x.status==e.toStatus && e.actorUid==request.auth.uid && e.at==request.time && e.note is string && e.note.size()<=1000;
  }
  // ------------------------------------------------------------------ Phase 4 notifications
  function activeMember(c,uid){return get(/databases/$(database)/documents/companies/$(c)/members/$(uid)).data.status=='active';}
  function notificationCreate(c,d){
   return d.keys().hasOnly(['companyId','schemaVersion','recipientUid','type','title','body','recordKind','recordId','createdAt','createdBy','readAt'])
    && d.companyId==c && d.schemaVersion==1 && d.recipientUid is string && activeMember(c,d.recipientUid)
    && d.type in ['task_assigned','task_due_soon','task_overdue','task_reassigned','task_submitted','task_awaiting_approval','task_rejected','task_rework','work_order_created','work_order_assigned','escalation_raised','sla_breach','maintenance_due','complaint_created','task_approved','issue_updated']
    && d.title is string && d.title.size()>0 && d.title.size()<=160 && d.body is string && d.body.size()<=500
    && d.recordKind in ['tasks','workOrders','complaints','escalations','recurringSchedules'] && d.recordId is string && d.recordId.matches('^[a-zA-Z0-9_-]{1,128}$')
    && d.createdAt==request.time && d.createdBy==request.auth.uid && d.readAt==null;
  }
  // ------------------------------------------------------------------ Phase 5 staff identity and scope
  // A staff login is linked to exactly one employee per company by an admin (staffLinks/{uid} + employeeLinks/{employeeId}).
  // Access needs: active membership, active link, active/probation employee and an active company. Document data is passed as arguments.
  function link(c){return get(/databases/$(database)/documents/companies/$(c)/staffLinks/$(request.auth.uid)).data;}
  function staffOk(c,m,l){return signedIn() && m.uid==request.auth.uid && m.companyId==c && m.status=='active' && m.role!='customer'
    && l.uid==request.auth.uid && l.status=='active' && get(/databases/$(database)/documents/companies/$(c)/employees/$(l.employeeId)).data.status in ['active','probation'] && activeCompany(c);}
  function staff(c){return staffOk(c,member(c),link(c));}
  function supervisorRole(m){return m.role in ['supervisor','site_manager','department_manager'];}
  function inScope(l,siteId){return l.allSites==true || siteId in l.siteIds;}
  function sees(m,l,t){return l.employeeId in t.assigneeIds || (supervisorRole(m) && inScope(l,t.siteId));}
  function staffView(c,t){return staffViewDoc(c,member(c),link(c),t);}
  function staffViewDoc(c,m,l,t){return staffOk(c,m,l) && sees(m,l,t);}
  // Assignees may run their own work in sites still in scope; supervisors may review, assign and reschedule within scope.
  function staffTaskUpdate(c,id,d,b){return staffActs(c,member(c),link(c),id,d,b);}
  function staffActs(c,m,l,id,d,b){
   return staffOk(c,m,l) && inScope(l,b.siteId) && taskUpdate(c,id,d,b)
    && ((l.employeeId in b.assigneeIds && (d.diff(b).affectedKeys().hasOnly(['draftAnswers','revision','updatedAt','updatedBy'])
         || getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_'+string(d.revision))).data.action in ['start','pause','resume','submit','restart']))
     || (supervisorRole(m) && getAfter(/databases/$(database)/documents/companies/$(c)/taskEvents/$(id+'_'+string(d.revision))).data.action in ['assign','approve','request_rework','reject','reschedule']));
  }
  function staffReviewer(c,t){return staffReviewerDoc(c,member(c),link(c),t);}
  function staffReviewerDoc(c,m,l,t){return staffOk(c,m,l) && supervisorRole(m) && inScope(l,t.siteId);}
  function staffSeesCase(m,l,x){return l.employeeId in x.assigneeIds || x.createdBy==request.auth.uid || (supervisorRole(m) && inScope(l,x.siteId));}
  function staffCase(c,x){return staffCaseDoc(c,member(c),link(c),x);}
  function staffCaseDoc(c,m,l,x){return staffOk(c,m,l) && staffSeesCase(m,l,x);}
  function staffCaseUpdate(c,k,id,d,b){return staffCaseActs(c,member(c),link(c),k,id,d,b);}
  function staffCaseActs(c,m,l,k,id,d,b){
   return staffOk(c,m,l) && inScope(l,b.siteId) && caseUpdate(c,k,id,d,b)
    && ((supervisorRole(m)) || (k=='workOrders' && l.employeeId in b.assigneeIds
     && getAfter(/databases/$(database)/documents/companies/$(c)/caseEvents/$(k+'_'+id+'_'+string(d.revision))).data.action in ['start','hold','resume','resolve','note']));
  }
  function staffCaseCreate(c,k,id,d){return staffCaseCreateDoc(c,member(c),link(c),k,id,d);}
  function staffCaseCreateDoc(c,m,l,k,id,d){
   return staffOk(c,m,l) && inScope(l,d.siteId) && caseCreate(c,k,id,d)
    && (k=='workOrders' ? d.sourceType in ['staff','task_exception'] : (supervisorRole(m) && k=='escalations'));
  }
  function staffMasterRead(c,kind,id,r){return staffMasterDoc(c,member(c),link(c),kind,id,r);}
  function staffMasterDoc(c,m,l,kind,id,r){
   return staffOk(c,m,l) && (kind=='sites' ? inScope(l,id)
    : kind in ['locations','facilities','assets'] ? inScope(l,r.siteId)
