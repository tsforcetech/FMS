  function shape_shifts(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','siteId','startTime','endTime','breakMinutes','workingDays','description']) && d.status in ['active','archived'] && (d.siteId).matches('^[a-zA-Z0-9_-]{1,128}$') && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.breakMinutes.matches('^$|^(0|[1-9][0-9]{0,6})$') && (d.breakMinutes=='' || (int(d.breakMinutes)>=0 && int(d.breakMinutes)<=600)) && (d.workingDays=='' || (d.workingDays.split(',').size()<=7 && d.workingDays.split(',').toSet().hasOnly(['Mon','Tue','Wed','Thu','Fri','Sat','Sun']))) && (d.description).size()<=2000;}
  function shape_shiftAssignments(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','employeeId','shiftId','startDate','endDate']) && d.status in ['active','ended','archived'] && (d.employeeId+'~'+d.shiftId).matches('^[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{1,128}$') && (d.startDate+'~'+d.endDate).matches('^([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))~([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?$');}
  function shape_holidays(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','holidayDate','siteId','description']) && d.status in ['active','archived'] && (d.siteId).matches('^[a-zA-Z0-9_-]{0,128}$') && (d.holidayDate).matches('^([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$') && (d.description).size()<=2000;}
  function shape_leaveRecords(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','employeeId','leaveType','startDate','endDate','reason']) && d.status in ['planned','approved','taken','cancelled','archived'] && (d.employeeId).matches('^[a-zA-Z0-9_-]{1,128}$') && (d.startDate+'~'+d.endDate).matches('^([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))~([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$') && d.leaveType in ['Annual','Sick','Unpaid','Emergency','Parental','Other'] && (d.reason).size()<=2000;}
  function shape_assetCategories(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','parentId','assetClass','description']) && d.status in ['active','archived'] && (d.parentId).matches('^[a-zA-Z0-9_-]{0,128}$') && d.assetClass in ['Equipment','Furniture','Fixture','Tool','IT equipment','Vehicle','Other'] && (d.description).size()<=2000;}
  function shape_suppliers(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','supplierType','contactPerson','phone','email','address','country','vatNumber']) && d.status in ['active','archived'] && d.supplierType in ['Assets','Materials','Assets and materials','Services'] && (d.contactPerson+d.phone+d.email+d.address+d.country+d.vatNumber).size()<=3000;}
  function shape_assets(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','assetTag','assetClass','categoryId','trackingMode','quantity','serialNumber','brand','model','siteId','locationId','facilityId','condition','custodianId','departmentId','supplierId','purchaseDate','purchaseCost','warrantyEndDate','description','lastTransferId']) && d.status in ['in_service','in_storage','under_maintenance','out_of_service','disposed','archived'] && (d.categoryId+'~'+d.siteId+'~'+d.locationId+'~'+d.facilityId+'~'+d.custodianId+'~'+d.departmentId+'~'+d.supplierId).matches('^[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{0,128}~[a-zA-Z0-9_-]{0,128}~[a-zA-Z0-9_-]{0,128}~[a-zA-Z0-9_-]{0,128}$') && (d.purchaseDate+'~'+d.warrantyEndDate).matches('^([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?~([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?$') && d.assetClass in ['Equipment','Furniture','Fixture','Tool','IT equipment','Vehicle','Other'] && d.trackingMode in ['individual','batch'] && d.quantity.matches('^(0|[1-9][0-9]{0,6})$') && (d.quantity=='' || (int(d.quantity)>=1 && int(d.quantity)<=100000)) && d.condition in ['Excellent','Good','Fair','Poor','Critical'] && d.purchaseCost.matches('^$|^(0|[1-9][0-9]{0,9})([.][0-9]{1,2})?$') && (d.assetTag+d.serialNumber+d.brand+d.model+d.description).size()<=2640;}
  function shape_materialCategories(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','description']) && d.status in ['active','archived'] && (d.description).size()<=2000;}
  function shape_materials(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','categoryId','unit','reorderLevel','preferredSupplierId','description']) && d.status in ['active','archived'] && (d.categoryId+'~'+d.preferredSupplierId).matches('^[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{0,128}$') && d.unit in ['each','box','pack','carton','pair','set','roll','bottle','kg','g','litre','ml','metre','sqm'] && d.reorderLevel.matches('^$|^(0|[1-9][0-9]{0,8})([.][0-9]{1,3})?$') && (d.description).size()<=2000;}
  function shape_stores(d){return d.keys().hasOnly(['companyId','schemaVersion','createdAt','updatedAt','createdBy','updatedBy','revision','refCount','witnessKind','witnessId','code','name','notes','status','siteId','locationId','storeKeeperId','description']) && d.status in ['active','archived'] && (d.siteId+'~'+d.locationId+'~'+d.storeKeeperId).matches('^[a-zA-Z0-9_-]{1,128}~[a-zA-Z0-9_-]{0,128}~[a-zA-Z0-9_-]{0,128}$') && (d.description).size()<=2000;}
  function known2(k){return k in ['departments','designations','employees','teams','teamMembers','siteAssignments','shifts','shiftAssignments','holidays','leaveRecords','assetCategories','suppliers','assets','materialCategories','materials','stores'];}
  function shape2(k,d){return k=='departments'?shape_departments(d):k=='designations'?shape_designations(d):k=='employees'?shape_employees(d):k=='teams'?shape_teams(d):k=='teamMembers'?shape_teamMembers(d):k=='siteAssignments'?shape_siteAssignments(d):k=='shifts'?shape_shifts(d):k=='shiftAssignments'?shape_shiftAssignments(d):k=='holidays'?shape_holidays(d):k=='leaveRecords'?shape_leaveRecords(d):k=='assetCategories'?shape_assetCategories(d):k=='suppliers'?shape_suppliers(d):k=='assets'?shape_assets(d):k=='materialCategories'?shape_materialCategories(d):k=='materials'?shape_materials(d):k=='stores'?shape_stores(d):false;}
  function refKeys2(k){return k=='departments'?['parentId','siteId']:k=='designations'?['departmentId']:k=='employees'?['departmentId','designationId']:k=='teams'?['departmentId']:k=='teamMembers'?['teamId','employeeId']:k=='siteAssignments'?['employeeId','siteId']:k=='shifts'?['siteId']:k=='shiftAssignments'?['employeeId','shiftId']:k=='holidays'?[]:k=='leaveRecords'?[]:k=='assetCategories'?['parentId']:k=='suppliers'?[]:k=='assets'?['categoryId','locationId']:k=='materialCategories'?[]:k=='materials'?['categoryId']:k=='stores'?['siteId','locationId']:[];}
  function immutable2(k){return k=='departments'?[]:k=='designations'?[]:k=='employees'?[]:k=='teams'?[]:k=='teamMembers'?['teamId','employeeId']:k=='siteAssignments'?['employeeId','siteId']:k=='shifts'?['siteId']:k=='shiftAssignments'?['employeeId','shiftId']:k=='holidays'?[]:k=='leaveRecords'?['employeeId']:k=='assetCategories'?[]:k=='suppliers'?[]:k=='assets'?['trackingMode']:k=='materialCategories'?[]:k=='materials'?['unit']:k=='stores'?['siteId']:[];}
  function relations2(c,k,id,creating){return k=='departments'?(ref2(c,k,id,'parentId','departments',creating) && ref2(c,k,id,'siteId','sites',creating)):k=='designations'?(ref2(c,k,id,'departmentId','departments',creating)):k=='employees'?(ref2(c,k,id,'departmentId','departments',creating) && ref2(c,k,id,'designationId','designations',creating)):k=='teams'?(ref2(c,k,id,'departmentId','departments',creating)):k=='teamMembers'?(ref2(c,k,id,'teamId','teams',creating) && ref2(c,k,id,'employeeId','employees',creating)):k=='siteAssignments'?(ref2(c,k,id,'employeeId','employees',creating) && ref2(c,k,id,'siteId','sites',creating)):k=='shifts'?(ref2(c,k,id,'siteId','sites',creating)):k=='shiftAssignments'?(ref2(c,k,id,'employeeId','employees',creating) && ref2(c,k,id,'shiftId','shifts',creating)):k=='holidays'?(true):k=='leaveRecords'?(true):k=='assetCategories'?(ref2(c,k,id,'parentId','assetCategories',creating)):k=='suppliers'?(true):k=='assets'?(ref2(c,k,id,'categoryId','assetCategories',creating) && ref2(c,k,id,'locationId','locations',creating)):k=='materialCategories'?(true):k=='materials'?(ref2(c,k,id,'categoryId','materialCategories',creating)):k=='stores'?(ref2(c,k,id,'siteId','sites',creating) && ref2(c,k,id,'locationId','locations',creating)):false;}
  function refField2(k,w){return k=='departments'?(w=='departments'?'parentId':w=='designations'?'departmentId':w=='employees'?'departmentId':w=='teams'?'departmentId':''):k=='sites'?(w=='departments'?'siteId':w=='siteAssignments'?'siteId':w=='shifts'?'siteId':w=='stores'?'siteId':''):k=='designations'?(w=='employees'?'designationId':''):k=='teams'?(w=='teamMembers'?'teamId':''):k=='employees'?(w=='teamMembers'?'employeeId':w=='siteAssignments'?'employeeId':w=='shiftAssignments'?'employeeId':''):k=='shifts'?(w=='shiftAssignments'?'shiftId':''):k=='assetCategories'?(w=='assetCategories'?'parentId':w=='assets'?'categoryId':''):k=='locations'?(w=='assets'?'locationId':w=='stores'?'locationId':''):k=='materialCategories'?(w=='materials'?'categoryId':''):'';}
  // END GENERATED PHASE 2 VALIDATORS
  match /users/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, create, delete: if false;
   allow update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['uid','displayName','schemaVersion','createdAt','updatedAt','createdBy','updatedBy'])
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt','updatedBy'])
    && request.resource.data.uid == uid
    && request.resource.data.schemaVersion == 1
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100
    && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == uid;
   match /companyAccess/{companyId} {
    // Discovery hints only. Every company request checks its canonical member document.
    allow get, list: if signedIn() && request.auth.uid == uid;
    allow write: if false;
   }
  }
  match /companies/{companyId} {
   allow get: if admin(companyId) && resource.data.companyId == companyId && resource.data.status == 'active';
   allow list, create, delete: if false;
   allow update: if admin(companyId) && activeCompany(companyId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','timeZone','contactEmail','contactPhone','address','country','updatedAt','updatedBy'])
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120
    && validZone(request.resource.data.timeZone)
    && optionalContact(request.resource.data)
    && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
   match /members/{uid} {
    allow get: if signedIn() && resource.data.uid == uid && resource.data.companyId == companyId
     && (request.auth.uid == uid || (admin(companyId) && activeCompany(companyId)));
    // Phase 2: owners/admins may list their company's members (read-only). Role changes stay trusted.
    allow list: if admin(companyId) && activeCompany(companyId);
    allow write: if false;
   }
   match /auditLogs/{eventId} {
    allow get: if admin(companyId) && activeCompany(companyId) && resource.data.companyId == companyId;
    allow list, write: if false;
   }

   match /codeClaims/{claimId} {
    allow get: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && request.resource.data.keys().hasOnly(['kind','recordId','code','companyId'])
     && request.resource.data.companyId==companyId && (known(request.resource.data.kind)||known2(request.resource.data.kind)||request.resource.data.kind=='contractAllocations')
     && claimId==request.resource.data.kind+'_'+request.resource.data.code
     && !exists(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.recordId))
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/$(request.resource.data.kind)/$(request.resource.data.recordId)).data.code==request.resource.data.code;
    allow update,delete,list: if false;
   }
   match /{kind}/{id} {
    allow read: if (known(kind) || known2(kind)) && admin(companyId) && activeCompany(companyId);
    allow create: if known(kind) && admin(companyId) && activeCompany(companyId)
     && business(companyId,kind,id) && (kind!='sites'||request.resource.data.schemaVersion==2)
     && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid
     && request.resource.data.status!='archived' && request.resource.data.revision==1 && request.resource.data.refCount==0
     && request.resource.data.witnessKind=='' && request.resource.data.witnessId==''
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/codeClaims/$(kind+'_'+request.resource.data.code)).data.recordId==id
     && (kind!='facilities' || facilityHistory(companyId,id)) && (kind!='contractAllocations'||allocationChange(companyId,id,true));
    allow update: if known(kind) && admin(companyId) && activeCompany(companyId) && (
     request.resource.data.refCount!=resource.data.refCount ? (request.resource.data.witnessKind=='contractAllocations'?allocationCounter(companyId,kind,id):(known2(request.resource.data.witnessKind)?counter2(companyId,kind,id):counter(companyId,kind,id))) : (
      business(companyId,kind,id)
      && request.resource.data.schemaVersion==resource.data.schemaVersion
      && (kind!='sites'||(request.resource.data.get('clientId','')==resource.data.get('clientId','')&&request.resource.data.get('contractId','')==resource.data.get('contractId','')))
      && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.createdBy==resource.data.createdBy
      && request.resource.data.code==resource.data.code && request.resource.data.revision==resource.data.revision+1
      && request.resource.data.diff(resource.data).affectedKeys().intersection(['clientId','contractId','siteId','parentId','locationId','typeId'].toSet()).size()<=1
      && request.resource.data.refCount==resource.data.refCount && request.resource.data.witnessKind==resource.data.witnessKind && request.resource.data.witnessId==resource.data.witnessId
      && (!(kind in ['locations','facilities']) || request.resource.data.siteId==resource.data.siteId)
      && (kind!='contracts' || resource.data.refCount==0 || (request.resource.data.clientId==resource.data.clientId&&request.resource.data.startDate==resource.data.startDate&&request.resource.data.endDate==resource.data.endDate))
      && (kind!='facilities' || facilityHistory(companyId,id))
      && (kind!='contractAllocations'||allocationChange(companyId,id,false))
     ));
    allow delete: if false;
   }
   match /{kind}/{id} {
    allow create: if known2(kind) && admin(companyId) && activeCompany(companyId) && create2(companyId,kind,id);
    allow update: if known2(kind) && admin(companyId) && activeCompany(companyId)
     && (request.resource.data.refCount!=resource.data.refCount ? counter2(companyId,kind,id) : update2(companyId,kind,id));
   }
   match /assets/{assetId}/history/{event} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && request.resource.data.keys().hasOnly(['companyId','revision','condition','status','siteId','locationId','custodianId','quantity','transferId','actorUid','occurredAt'])
     && request.resource.data.companyId==companyId && event==string(request.resource.data.revision)
     && request.resource.data.revision==getAfter(/databases/$(database)/documents/companies/$(companyId)/assets/$(assetId)).data.revision
     && (!exists(/databases/$(database)/documents/companies/$(companyId)/assets/$(assetId)) || request.resource.data.revision==get(/databases/$(database)/documents/companies/$(companyId)/assets/$(assetId)).data.revision+1)
     && request.resource.data.actorUid==request.auth.uid && request.resource.data.occurredAt==request.time;
    allow update,delete: if false;
   }
   match /assetTransfers/{transferId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && transferValid(companyId,transferId);
    allow update,delete: if false;
   }
   match /stockMovements/{movementId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && movementValid(companyId,movementId);
    allow update,delete: if false;
   }
   match /stockBalances/{balanceId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId) && balanceValid(companyId,balanceId,{'quantity':0,'revision':0},true);
    allow update: if admin(companyId) && activeCompany(companyId) && balanceValid(companyId,balanceId,resource.data,false)
     && request.resource.data.storeId==resource.data.storeId && request.resource.data.materialId==resource.data.materialId;
    allow delete: if false;
   }
   match /facilities/{facilityId}/history/{eventId} {
    allow read: if admin(companyId) && activeCompany(companyId);
    allow create: if admin(companyId) && activeCompany(companyId)
     && request.resource.data.keys().hasOnly(['companyId','revision','condition','status','actorUid','occurredAt'])
     && request.resource.data.companyId==companyId && eventId==string(request.resource.data.revision)
     && request.resource.data.revision==getAfter(/databases/$(database)/documents/companies/$(companyId)/$('facilities')/$(facilityId)).data.revision
     && (!exists(/databases/$(database)/documents/companies/$(companyId)/$('facilities')/$(facilityId)) || request.resource.data.revision==get(/databases/$(database)/documents/companies/$(companyId)/$('facilities')/$(facilityId)).data.revision+1)
     && request.resource.data.condition==getAfter(/databases/$(database)/documents/companies/$(companyId)/$('facilities')/$(facilityId)).data.condition
     && request.resource.data.status==getAfter(/databases/$(database)/documents/companies/$(companyId)/$('facilities')/$(facilityId)).data.status
     && request.resource.data.actorUid==request.auth.uid && request.resource.data.occurredAt==request.time;
    allow update,delete: if false;
   }

   match /contractAllocations/{id} {
    allow read: if admin(companyId)&&activeCompany(companyId);
    allow create: if admin(companyId)&&activeCompany(companyId)&&allocationValid(companyId,id,true)
     && request.resource.data.createdAt==request.time&&request.resource.data.createdBy==request.auth.uid&&request.resource.data.revision==1
     && getAfter(/databases/$(database)/documents/companies/$(companyId)/codeClaims/$('contractAllocations_'+request.resource.data.code)).data.recordId==id
     && allocationChange(companyId,id,true);
    allow update: if admin(companyId)&&activeCompany(companyId)&&allocationValid(companyId,id,false)
     && request.resource.data.createdAt==resource.data.createdAt&&request.resource.data.createdBy==resource.data.createdBy&&request.resource.data.code==resource.data.code&&request.resource.data.revision==resource.data.revision+1
     && allocationChange(companyId,id,false);
    allow delete: if false;
   }
   match /occupancyCalendars/{id} {
    allow get: if admin(companyId)&&activeCompany(companyId);
    allow create: if admin(companyId)&&activeCompany(companyId)&&validCalendar(companyId,id,true);
    allow update: if admin(companyId)&&activeCompany(companyId)&&validCalendar(companyId,id,false);
    allow list,delete: if false;
   }
   match /contractAllocations/{id}/history/{event} {
    allow read: if admin(companyId)&&activeCompany(companyId);
    allow create: if admin(companyId)&&activeCompany(companyId)
     && request.resource.data.keys().hasOnly(['companyId','revision','actorUid','occurredAt','snapshot'])
     && request.resource.data.companyId==companyId && request.resource.data.actorUid==request.auth.uid && request.resource.data.occurredAt==request.time
     && event==string(request.resource.data.revision)
     && request.resource.data.snapshot==allocationSnapshot(getAfter(/databases/$(database)/documents/companies/$(companyId)/contractAllocations/$(id)).data)
     && request.resource.data.revision==getAfter(/databases/$(database)/documents/companies/$(companyId)/contractAllocations/$(id)).data.revision
     && (!exists(/databases/$(database)/documents/companies/$(companyId)/contractAllocations/$(id))||request.resource.data.revision==get(/databases/$(database)/documents/companies/$(companyId)/contractAllocations/$(id)).data.revision+1);
    allow update,delete: if false;
   }
   // Future site-scoped modules remain closed until their own permission tests exist.
   match /{document=**} {allow read, write: if false;}
  }
  match /{document=**} {allow read, write: if false;}
 }
}
