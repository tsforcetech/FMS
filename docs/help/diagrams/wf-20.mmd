%% title: Stock transfer and reversal
%% articles: inventory.movements,inventory.reversal
%% sources: apps/admin-web/src/management/store.ts,packages/shared/src/inventory.ts,firebase/firestore.rules
flowchart TD
  S([Start]) --> A["[Admin] Transfer between stores"]:::admin
  A --> B{"Enough stock in source?"}
  B -- No --> E1["Refused"]:::stop --> X([End])
  B -- Yes --> C["Both balances updated<br/>in one transaction"]:::system
  C --> D{"Mistake found?"}
  D -- No --> X
  D -- Yes --> F["[Admin] Reverse the movement"]:::admin
  F --> G{"Already reversed, or is<br/>itself a reversal?"}
  G -- Yes --> E2["Refused: reverse once only"]:::stop --> X
  G -- No --> H{"Reversal would make a<br/>balance negative?"}
  H -- Yes --> E3["Refused"]:::stop --> X
  H -- No --> I["Opposite movement posted<br/>original kept in ledger"]:::system --> X
  classDef admin fill:#e8f0fe,stroke:#1d4ed8,color:#0f172a
  classDef staff fill:#ecfdf5,stroke:#047857,color:#0f172a
  classDef customer fill:#fdf4ff,stroke:#a21caf,color:#0f172a
  classDef platform fill:#fff7ed,stroke:#c2410c,color:#0f172a
  classDef system fill:#f1f5f9,stroke:#475569,color:#0f172a
  classDef stop fill:#fee2e2,stroke:#b91c1c,color:#0f172a
