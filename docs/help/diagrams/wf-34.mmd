%% title: Issue escalation
%% articles: cases.escalations,cases.reported-issues
%% sources: packages/shared/src/cases.ts,apps/admin-web/src/management/casesStore.ts
flowchart TD
  S([Start]) --> A["Escalation raised to a department<br/>(from case or task exception)"]:::admin
  A --> B["raised"]:::system
  B --> C{"Right department?"}
  C -- No --> D["Reassign department<br/>(reason)"]:::admin --> B
  C -- Yes --> E["Acknowledge + assign"]:::admin
  E --> F["Start"]:::staff
  F --> G["Resolve (reason)"]:::staff
  E --> G
  G --> H["Close"]:::admin --> X([End])
  F --> I{"Needs higher level?"}
  I -- Yes --> J["Escalate further:<br/>new linked escalation"]:::admin --> B
  classDef admin fill:#e8f0fe,stroke:#1d4ed8,color:#0f172a
  classDef staff fill:#ecfdf5,stroke:#047857,color:#0f172a
  classDef customer fill:#fdf4ff,stroke:#a21caf,color:#0f172a
  classDef platform fill:#fff7ed,stroke:#c2410c,color:#0f172a
  classDef system fill:#f1f5f9,stroke:#475569,color:#0f172a
  classDef stop fill:#fee2e2,stroke:#b91c1c,color:#0f172a
