%% title: Subscription lifecycle
%% articles: platform.subscriptions,saas.plan-usage,saas.read-only,ops.subscription-sweep
%% sources: packages/shared/src/saas.ts,apps/platform-web/src/store.ts,apps/platform-web/src/App.tsx,scripts/subscription-sweep.ts
stateDiagram-v2
  [*] --> running: Assign plan
  state running {
    [*] --> trial: Plan has trial days
    [*] --> active: No trial
    trial --> trial: Extend trial
    trial --> active: Renew
    trial --> past_due: Trial ended
    past_due --> trial: Extend trial
    past_due --> active: Renew
    past_due --> expired: 30 days unpaid
    active --> renewal_due: 14 days before end
    renewal_due --> active: Renew
    renewal_due --> grace: Period ended
    grace --> active: Renew
    grace --> past_due: Grace days over
    expired --> active: Renew
  }
  running --> suspended: Suspend
  running --> cancelled: Cancel
  suspended --> cancelled: Cancel
  suspended --> running: Reactivate
  cancelled --> running: Reactivate
  note right of suspended
    suspended, cancelled, expired = read-only company
    data kept, reads and exports allowed;
    after Reactivate the status follows the dates
  end note
  note left of running
    date-based changes applied by the
    subscription sweep (operator-run;
    automation pending activation)
  end note
