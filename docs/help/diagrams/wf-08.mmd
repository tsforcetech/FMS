flowchart TD
  S([Start]) --> A["[Admin] Property > Sites<br/>Add site"]:::admin
  A --> B{"Code unique and<br/>fields valid?"}
  B -- No --> E1["Fix form errors"]:::stop --> A
  B -- Yes --> Q{"Plan site limit reached?"}
  Q -- Yes --> E2["Refused: upgrade or<br/>archive unused sites"]:::stop --> X([End])
  Q -- No --> C["Site saved<br/>(no client or contract needed)"]:::system
  C --> D["[Admin] Locations: add building"]:::admin
  D --> F["Add floors and rooms<br/>with parent location"]:::admin
  F --> G{"Parent in same site<br/>and depth allowed?"}
  G -- No --> E3["Choose another parent"]:::stop --> F
  G -- Yes --> H["Location tree saved"]:::system
  H --> I["[Admin] Facilities: add<br/>facility in a location"]:::admin --> X
