flowchart TD
  S([Start]) --> O{"Online?"}
  O -- No --> E0["Needs a connection"]:::stop --> X([End])
  O -- Yes --> A["[Staff] Attendance: Check in<br/>(shown once per day)"]:::staff
  A --> B{"Location available?"}
  B -- Yes --> C["GPS reading attached"]:::system
  B -- No --> D["Check in without location"]:::system
  C --> E{"Record for today exists?"}
  D --> E
  E -- Yes --> E1["Existing record kept:<br/>one per employee per day"]:::system --> X
  E -- No --> F["Server time recorded,<br/>late minutes from shift"]:::system
  F --> G["[Staff] Check out later"]:::staff
  G --> H["checked_out"]:::system
  H --> I{"Error in record?"}
  I -- Yes --> J["[Supervisor in scope or Admin]<br/>correct with reason<br/>(data layer and rules only; no screen yet)"]:::admin --> X
  I -- No --> X
  classDef admin fill:#e8f0fe,stroke:#1d4ed8,color:#0f172a
  classDef staff fill:#ecfdf5,stroke:#047857,color:#0f172a
  classDef customer fill:#fdf4ff,stroke:#a21caf,color:#0f172a
  classDef platform fill:#fff7ed,stroke:#c2410c,color:#0f172a
