{
  "name": "facilityos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/admin-web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @facilityos/admin-web",
    "build": "npm run build -w @facilityos/admin-web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --project demo-facilityos --only auth,firestore \"vitest run --config vitest.emulator.config.ts\"",
    "emulators": "firebase emulators:start --project demo-facilityos --only auth,firestore",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "provision:owner": "node scripts/provision-owner.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "firebase emulators:exec --project demo-facilityos --only auth,firestore \"node scripts/phase1-browser-test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "globals": "^16.0.0",
    "jsdom": "^31.0.0",
    "playwright": "1.62.1",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
